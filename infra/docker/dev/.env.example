# Database Configuration
DB_PASSWORD=YourStrong@Pass123
DB_NAME=AcadPrepDb
DB_PORT=5432

# JWT Configuration
JWT_SECRET=YourSuperSecretKeyMin32Characters!!
JWT_ISSUER=AcadPrepBackend
JWT_AUDIENCE=AcadPrepFrontend

# Admin Seed Configuration
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=your_admin@email.com
ADMIN_PASSWORD=YourAdmin@Password123

# App Configuration
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Google OAuth (lấy từ Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary (Dashboard → API Keys). Không commit giá trị thật.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret