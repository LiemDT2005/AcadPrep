@page "{vocabularyId:int}"
@model AcadPrep.WebUI.Pages.Vocabulary.VocabularyDetailModel
@{
    ViewData["Title"] = "Vocabulary Context Passage";
}

<div class="container mt-5">
    <h2>Context Passage</h2>
    <hr />

    @if (Model.Passages == null || !Model.Passages.Any())
    {
        <div class="alert alert-info">
            <h4>No specific context passage available</h4>
            <p>We don't have any reading passages associated with this vocabulary word yet.</p>
        </div>
    }
    else
    {
        <div class="list-group mb-4">
            @foreach (var passage in Model.Passages)
            {
                <div class="list-group-item">
                    <p class="mb-1" style="white-space: pre-wrap;">@passage.Content</p>
                </div>
            }
        </div>
    }

    <a asp-page="./DictionarySearch" class="btn btn-secondary mt-3">Back to Dictionary</a>
</div>
