@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        var scoreData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ScoreProgressData.Scores.OrderBy(s => s.AttemptDate).Select(s => new {
            label = s.AttemptDate.ToString("dd/MM"),
            score = s.Score
        })));
        
        var labels = scoreData.map(function(e) { return e.label; });
        var data = scoreData.map(function(e) { return e.score; });

        if(labels.length === 0) {
            labels = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
            data = [0, 0, 0, 0, 0, 0, 0];
        }

        var ctx = document.getElementById('dashboardScoreChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Total Score',
                    data: data,
                    borderColor: '#1e00a9',
                    backgroundColor: 'rgba(30, 0, 169, 0.1)',
                    borderWidth: 2,
                    pointBackgroundColor: '#1e00a9',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 1.5,
                    pointRadius: 3,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1C1B1F',
                        titleFont: { family: 'Inter', size: 10 },
                        bodyFont:  { family: 'Inter', size: 12, weight: 'bold' },
                        padding: 8,
                        cornerRadius: 6
                    }
                },
                scales: {
                    y: {
                        min: 0,
                        max: 990,
                        ticks: { stepSize: 300, color: '#777587', font: { family: 'Inter', size: 8 } },
                        grid:  { color: 'rgba(0,0,0,0.04)' },
                        border: { display: false }
                    },
                    x: {
                        ticks: { color: '#777587', font: { family: 'Inter', size: 8 } },
                        grid: { display: false },
                        border: { display: false }
                    }
                }
            }
        });

        // Micro-interactions
        document.querySelectorAll('button, a').forEach(btn => {
            btn.addEventListener('mousedown', function() {
                this.style.transform = 'scale(0.98)';
            });
            btn.addEventListener('mouseup', function() {
                this.style.transform = 'scale(1)';
            });
        });
    </script>
}
