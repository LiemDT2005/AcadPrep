@page "{handler?}"
@model AcadPrep.WebUI.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
    var step = Model.Step;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu — AcadPrep</title>
    <meta name="description" content="Đặt lại mật khẩu AcadPrep của bạn qua mã OTP được gửi về email." />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>
    <script>
        tailwind.config = {
          theme: {
            extend: {
              colors: {
                primary:    "#1e00a9",
                "primary-dark": "#16007e",
                surface:    "#fcf8ff",
                "surface-card": "#ffffff",
                accent:     "#3525cd",
                muted:      "#464555",
                border:     "#c7c4d8",
                error:      "#ba1a1a",
                "error-bg": "#ffdad6",
                success:    "#006c4c",
                "success-bg": "#89f8c7",
              },
              fontFamily: { sans: ["Inter", "sans-serif"] },
              boxShadow: {
                card:   "0 4px 24px rgba(30,0,169,0.08), 0 1px 4px rgba(30,0,169,0.04)",
                "card-hover": "0 8px 40px rgba(30,0,169,0.14), 0 2px 8px rgba(30,0,169,0.06)",
              }
            }
          }
        }
    </script>
    <style>
        body { font-family: "Inter", sans-serif; }

        /* Gradient background */
        .fp-bg {
            background: linear-gradient(135deg, #1e00a9 0%, #3525cd 40%, #6b5fff 100%);
        }

        /* Glass card */
        .glass-card {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* Input focus ring */
        .input-field:focus {
            outline: none;
            border-color: #1e00a9;
            box-shadow: 0 0 0 3px rgba(30,0,169,0.15);
        }

        /* Input icon layout */
        .input-wrap { position: relative; }
        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #787680;
            pointer-events: none;
            z-index: 1;
        }
        .input-field {
            box-sizing: border-box;
            position: relative;
            width: 100%;
            padding-left: 2.75rem !important;
        }
        .input-field-password { padding-right: 2.75rem !important; }

        /* Button */
        .btn-primary { transition: transform 0.15s ease, box-shadow 0.15s ease; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(30,0,169,0.35); }
        .btn-primary:active { transform: translateY(0); }

        /* Step indicator */
        .step-dot {
            width: 32px; height: 32px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 700;
            transition: all 0.3s ease;
        }
        .step-dot.active  { background: #1e00a9; color: #fff; }
        .step-dot.done    { background: #006c4c; color: #fff; }
        .step-dot.pending { background: #e8e6f0; color: #787680; }
        .step-line { height: 2px; flex: 1; background: #c7c4d8; margin: 0 6px; border-radius: 1px; }
        .step-line.done { background: #006c4c; }

        /* OTP input */
        .otp-input {
            letter-spacing: 0.5em;
            text-align: center;
            font-size: 1.5rem;
            font-weight: 700;
            font-family: 'Courier New', monospace;
        }

        /* Fade-in animation */
        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-up { animation: fadeUp 0.5s ease both; }
        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }

        /* Password toggle */
        .btn-toggle-pw {
            position: absolute; right: 12px; top: 50%;
            transform: translateY(-50%);
            background: none; border: none; cursor: pointer;
            color: #787680; transition: color 0.15s ease;
            z-index: 1;
        }
        .btn-toggle-pw:hover { color: #1e00a9; }
    </style>
</head>
<body class="min-h-screen fp-bg flex items-center justify-center p-4">

<div class="w-full max-w-md fade-up">

    <!-- Logo / Brand -->
    <div class="text-center mb-8 fade-up delay-1">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-white/20 rounded-2xl mb-4 backdrop-blur-sm">
            <i class="fa-solid fa-graduation-cap text-3xl text-white"></i>
        </div>
        <h1 class="text-3xl font-bold text-white tracking-tight">AcadPrep</h1>
        <p class="text-white/70 text-sm mt-1">Luyện thi TOEIC thông minh</p>
    </div>

    <!-- Card -->
    <div class="glass-card bg-white rounded-3xl shadow-card p-8 fade-up delay-2">

        <!-- Step indicator -->
        <div class="flex items-center mb-6">
            <!-- Step 1 -->
            <div class="flex flex-col items-center">
                <div class="step-dot @(step >= 2 ? "done" : "active")">
                    @if (step >= 2)
                    {
                        <i class="fa-solid fa-check text-xs"></i>
                    }
                    else
                    {
                        <span>1</span>
                    }
                </div>
                <span class="text-xs mt-1 @(step >= 1 ? "text-primary font-medium" : "text-muted")">Email</span>
            </div>
            <div class="step-line @(step >= 2 ? "done" : "")"></div>
            <!-- Step 2 -->
            <div class="flex flex-col items-center">
                <div class="step-dot @(step == 2 ? "active" : "pending")">
                    <span>2</span>
                </div>
                <span class="text-xs mt-1 @(step == 2 ? "text-primary font-medium" : "text-muted")">Đặt lại</span>
            </div>
        </div>

        @if (step == 1)
        {
            <!-- ═══ STEP 1: Nhập email ═══ -->
            <h2 class="text-2xl font-bold text-gray-900 mb-1">Quên mật khẩu?</h2>
            <p class="text-muted text-sm mb-6">
                Nhập email đăng ký của bạn. Chúng tôi sẽ gửi mã OTP để đặt lại mật khẩu.
            </p>

            <!-- Alert lỗi -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div id="alert-error" role="alert"
                     class="flex items-start gap-3 rounded-xl px-4 py-3 mb-5 bg-error-bg text-error text-sm">
                    <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form id="form-send-otp" method="post" asp-page-handler="SendOtp" novalidate class="space-y-5 fade-up delay-3">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="space-y-1">
                    <label for="email-input" class="block text-sm font-medium text-gray-700">Địa chỉ email</label>
                    <div class="input-wrap">
                        <span class="input-icon"><i class="fa-regular fa-envelope text-sm"></i></span>
                        <input id="email-input"
                               type="email"
                               name="Email"
                               value="@Model.Email"
                               placeholder="ban@@example.com"
                               autocomplete="email"
                               class="input-field w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary transition" />
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit" id="btn-send-otp"
                        class="btn-primary w-full rounded-xl bg-primary py-3 text-sm font-semibold text-white shadow-md mt-2">
                    <i class="fa-regular fa-paper-plane mr-2"></i>Gửi mã OTP
                </button>
            </form>
        }
        else
        {
            <!-- ═══ STEP 2: Nhập OTP + mật khẩu mới ═══ -->
            <h2 class="text-2xl font-bold text-gray-900 mb-1">Đặt lại mật khẩu</h2>
            <p class="text-muted text-sm mb-6">
                Nhập mã OTP 6 số đã được gửi tới email của bạn và tạo mật khẩu mới.
            </p>

            <!-- Alert thành công (xác nhận OTP đã gửi) -->
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div id="alert-success" role="alert"
                     class="flex items-start gap-3 rounded-xl px-4 py-3 mb-5 bg-success-bg text-success text-sm">
                    <i class="fa-solid fa-circle-check mt-0.5 shrink-0"></i>
                    <span>@Model.SuccessMessage</span>
                </div>
            }

            <!-- Alert lỗi -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div id="alert-error" role="alert"
                     class="flex items-start gap-3 rounded-xl px-4 py-3 mb-5 bg-error-bg text-error text-sm">
                    <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form id="form-reset" method="post" asp-page-handler="Reset" novalidate class="space-y-5 fade-up delay-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Email" value="@Model.Email" />

                <!-- OTP Code -->
                <div class="space-y-1">
                    <label for="otp-input" class="block text-sm font-medium text-gray-700">Mã OTP</label>
                    <input id="otp-input"
                           type="text"
                           name="OtpCode"
                           inputmode="numeric"
                           maxlength="6"
                           placeholder="• • • • • •"
                           autocomplete="one-time-code"
                           class="otp-input input-field w-full rounded-xl border border-border bg-surface px-4 py-3 text-gray-900 focus:border-primary transition" />
                    <p class="text-xs text-muted">Mã OTP có hiệu lực trong 5 phút.</p>
                </div>

                <!-- New Password -->
                <div class="space-y-1">
                    <label for="new-password-input" class="block text-sm font-medium text-gray-700">Mật khẩu mới</label>
                    <div class="input-wrap">
                        <span class="input-icon"><i class="fa-solid fa-lock text-sm"></i></span>
                        <input id="new-password-input"
                               type="password"
                               name="NewPassword"
                               placeholder="Tối thiểu 8 ký tự"
                               autocomplete="new-password"
                               disabled
                               class="input-field input-field-password w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary transition disabled:opacity-50 disabled:cursor-not-allowed" />
                        <button type="button" id="btn-toggle-new" class="btn-toggle-pw disabled:opacity-50 disabled:cursor-not-allowed" aria-label="Hiện / Ẩn mật khẩu mới"
                                disabled
                                onclick="togglePassword('new-password-input', 'toggle-icon-new')">
                            <i id="toggle-icon-new" class="fa-regular fa-eye text-sm"></i>
                        </button>
                    </div>
                    <p class="text-xs text-muted">Phải có chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
                </div>

                <!-- Confirm Password -->
                <div class="space-y-1">
                    <label for="confirm-password-input" class="block text-sm font-medium text-gray-700">Xác nhận mật khẩu</label>
                    <div class="input-wrap">
                        <span class="input-icon"><i class="fa-solid fa-lock text-sm"></i></span>
                        <input id="confirm-password-input"
                               type="password"
                               name="ConfirmPassword"
                               placeholder="Nhập lại mật khẩu mới"
                               autocomplete="new-password"
                               disabled
                               class="input-field input-field-password w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary transition disabled:opacity-50 disabled:cursor-not-allowed" />
                        <button type="button" id="btn-toggle-confirm" class="btn-toggle-pw disabled:opacity-50 disabled:cursor-not-allowed" aria-label="Hiện / Ẩn xác nhận mật khẩu"
                                disabled
                                onclick="togglePassword('confirm-password-input', 'toggle-icon-confirm')">
                            <i id="toggle-icon-confirm" class="fa-regular fa-eye text-sm"></i>
                        </button>
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit" id="btn-reset" disabled
                        class="btn-primary w-full rounded-xl bg-primary py-3 text-sm font-semibold text-white shadow-md mt-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:transform-none disabled:hover:shadow-md">
                    <i class="fa-solid fa-shield-halved mr-2"></i>Đặt lại mật khẩu
                </button>
            </form>

            <!-- Quay lại Step 1 -->
            <div class="mt-4 text-center">
                <a href="/Account/ForgotPassword" class="text-xs text-primary hover:underline font-medium">
                    <i class="fa-solid fa-arrow-left mr-1"></i>Nhập email khác
                </a>
            </div>
        }

        <!-- Back to Login -->
        <p class="mt-6 text-center text-sm text-muted">
            Đã nhớ mật khẩu?
            <a href="/Account/Login" class="text-primary font-semibold hover:underline">Đăng nhập</a>
        </p>

    </div>

    <!-- Footer -->
    <p class="mt-6 text-center text-xs text-white/50 fade-up delay-3">
        © @DateTime.UtcNow.Year AcadPrep · Mọi quyền được bảo lưu
    </p>
</div>

<script>
    // Toggle show/hide password
    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon  = document.getElementById(iconId);
        if (!input || !icon) { return; }
        const isHidden = input.type === 'password';
        input.type  = isHidden ? 'text' : 'password';
        icon.className = isHidden ? 'fa-regular fa-eye-slash text-sm' : 'fa-regular fa-eye text-sm';
    }

    // Loading state — form gửi OTP
    const formSendOtp = document.getElementById('form-send-otp');
    const btnSendOtp  = document.getElementById('btn-send-otp');
    if (formSendOtp && btnSendOtp) {
        formSendOtp.addEventListener('submit', () => {
            btnSendOtp.disabled = true;
            btnSendOtp.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>Đang gửi...';
        });
    }

    // Loading state — form reset password
    const formReset = document.getElementById('form-reset');
    const btnReset  = document.getElementById('btn-reset');
    if (formReset && btnReset) {
        formReset.addEventListener('submit', () => {
            btnReset.disabled = true;
            btnReset.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>Đang xử lý...';
        });
    }

    // OTP input: chỉ cho phép nhập số & Unlock fields khi đủ 6 số
    const otpInput = document.getElementById('otp-input');
    const newPwInput = document.getElementById('new-password-input');
    const confirmPwInput = document.getElementById('confirm-password-input');
    const btnToggleNew = document.getElementById('btn-toggle-new');
    const btnToggleConfirm = document.getElementById('btn-toggle-confirm');
    if (otpInput) {
        otpInput.addEventListener('input', function() {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
            
            const isFull = this.value.length === 6;
            
            if (newPwInput) newPwInput.disabled = !isFull;
            if (confirmPwInput) confirmPwInput.disabled = !isFull;
            if (btnToggleNew) btnToggleNew.disabled = !isFull;
            if (btnToggleConfirm) btnToggleConfirm.disabled = !isFull;
            if (btnReset) btnReset.disabled = !isFull;
        });
        
        // Trigger 1 lần lúc load trang (nếu có giá trị cũ truyền lại khi lỗi)
        otpInput.dispatchEvent(new Event('input'));
    }
</script>
</body>
</html>
