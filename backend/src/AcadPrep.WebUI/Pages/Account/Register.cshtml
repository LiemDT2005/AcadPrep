@page
@model AcadPrep.WebUI.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null; // Trang register dùng layout riêng — không có navbar
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register — AcadPrep</title>
    <meta name="description" content="Create a free AcadPrep account to start preparing for TOEIC, tracking your progress, and achieving your goals." />
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>
    <script>
        tailwind.config = {
          theme: {
            extend: {
              colors: {
                primary:    "#1e00a9",
                "primary-dark": "#16007e",
                surface:    "#fcf8ff",
                "surface-card": "#ffffff",
                accent:     "#3525cd",
                muted:      "#464555",
                border:     "#c7c4d8",
                error:      "#ba1a1a",
                "error-bg": "#ffdad6",
                success:    "#006c4c",
                "success-bg": "#89f8c7",
                warning:    "#7c5800",
                "warning-bg": "#ffdfa1"
              },
              fontFamily: { sans: ["Inter", "sans-serif"] },
              boxShadow: {
                card:        "0 4px 24px rgba(30,0,169,0.08), 0 1px 4px rgba(30,0,169,0.04)",
                "card-hover":"0 8px 40px rgba(30,0,169,0.14), 0 2px 8px rgba(30,0,169,0.06)",
              }
            }
          }
        }
    </script>
    <style>
        body { font-family: "Inter", sans-serif; }

        /* Gradient background */
        .register-bg {
            background: linear-gradient(135deg, #1e00a9 0%, #3525cd 40%, #6b5fff 100%);
        }

        /* Glass card */
        .glass-card {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* Input focus ring */
        .input-field:focus {
            outline: none;
            border-color: #1e00a9;
            box-shadow: 0 0 0 3px rgba(30,0,169,0.15);
        }

        /* Input icon */
        .input-wrap { position: relative; }
        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #787680;
            pointer-events: none;
        }
        .input-field { padding-left: 2.75rem !important; }

        /* Button hover lift */
        .btn-primary { transition: transform 0.15s ease, box-shadow 0.15s ease; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(30,0,169,0.35); }
        .btn-primary:active { transform: translateY(0); }

        /* Fade-in animation */
        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-up { animation: fadeUp 0.5s ease both; }
        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        /* Password strength dots */
        .strength-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: #c7c4d8;
            transition: background 0.2s ease;
        }


    </style>
</head>
<body class="min-h-screen register-bg flex items-center justify-center p-4">

<div class="w-full max-w-md fade-up">

    <!-- Logo / Brand -->
    <div class="text-center mb-8 fade-up delay-1">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-white/20 rounded-2xl mb-4 backdrop-blur-sm">
            <i class="fa-solid fa-graduation-cap text-3xl text-white"></i>
        </div>
        <h1 class="text-3xl font-bold text-white tracking-tight">AcadPrep</h1>
        <p class="text-white/70 text-sm mt-1">Smart TOEIC Preparation</p>
    </div>

    <!-- Card -->
    <div class="glass-card bg-white rounded-3xl shadow-card p-8 fade-up delay-2">
        <h2 class="text-2xl font-bold text-gray-900 mb-1">Create an account</h2>
        <p class="text-muted text-sm mb-6">Register for free and start your TOEIC journey.</p>

        <!-- ═══ Alert: Lỗi từ Handler / Validator ═══ -->
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div id="alert-error" role="alert"
                 class="flex items-start gap-3 rounded-xl px-4 py-3 mb-5 bg-error-bg text-error text-sm">
                <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <!-- ═══ Form ═══ -->
        <form method="post" asp-page="/Account/Register"
              id="register-form" novalidate class="space-y-4 fade-up delay-3">
            @Html.AntiForgeryToken()

            <!-- FullName -->
            <div class="space-y-1">
                <label for="fullname-input" class="block text-sm font-medium text-gray-700">Full Name</label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-regular fa-user text-sm"></i></span>
                    <input id="fullname-input"
                           type="text"
                           name="FullName"
                           value="@Model.FullName"
                           placeholder="John Doe"
                           autocomplete="name"
                           class="input-field w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary transition" />
                </div>
            </div>

            <!-- Email -->
            <div class="space-y-1">
                <label for="email-input" class="block text-sm font-medium text-gray-700">Email Address</label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-regular fa-envelope text-sm"></i></span>
                    <input id="email-input"
                           type="email"
                           name="Email"
                           value="@Model.Email"
                           placeholder="you@example.com"
                           autocomplete="email"
                           class="input-field w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary transition" />
                </div>
            </div>

            <!-- Password -->
            <div class="space-y-1">
                <label for="password-input" class="block text-sm font-medium text-gray-700">Password</label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-lock text-sm"></i></span>
                    <input id="password-input"
                           type="password"
                           name="Password"
                           placeholder="Minimum 8 characters"
                           autocomplete="new-password"
                           class="input-field w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary transition" />
                    <button type="button" id="toggle-password"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition"
                            aria-label="Show / Hide password">
                        <i id="toggle-icon-pw" class="fa-regular fa-eye text-sm"></i>
                    </button>
                </div>
                <!-- Password strength indicator -->
                <div class="flex gap-1.5 mt-2" id="strength-bar" aria-hidden="true">
                    <div class="strength-dot" id="dot-1"></div>
                    <div class="strength-dot" id="dot-2"></div>
                    <div class="strength-dot" id="dot-3"></div>
                    <div class="strength-dot" id="dot-4"></div>
                </div>
                <p class="text-xs text-muted mt-1">Must contain uppercase, lowercase, number, and special character.</p>
            </div>

            <!-- ConfirmPassword -->
            <div class="space-y-1">
                <label for="confirm-password-input" class="block text-sm font-medium text-gray-700">Confirm Password</label>
                <div class="input-wrap">
                    <span class="input-icon"><i class="fa-solid fa-lock text-sm"></i></span>
                    <input id="confirm-password-input"
                           type="password"
                           name="ConfirmPassword"
                           placeholder="Re-enter your password"
                           autocomplete="new-password"
                           class="input-field w-full rounded-xl border border-border bg-surface px-4 py-3 text-sm text-gray-900 placeholder:text-gray-400 focus:border-primary transition" />
                    <button type="button" id="toggle-confirm"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition"
                            aria-label="Show / Hide confirm password">
                        <i id="toggle-icon-confirm" class="fa-regular fa-eye text-sm"></i>
                    </button>
                </div>
                <p id="confirm-mismatch" class="text-xs text-error hidden mt-1">
                    <i class="fa-solid fa-circle-exclamation mr-1"></i>Passwords do not match.
                </p>
            </div>

            <!-- Submit -->
            <button type="submit" id="btn-register"
                    class="btn-primary w-full rounded-xl bg-primary py-3 text-sm font-semibold text-white shadow-md mt-2">
                Create Account
            </button>
        </form>

        <!-- Register link -->
        <p class="mt-6 text-center text-sm text-muted fade-up delay-4">
            Already have an account?
            <a href="/Account/Login" class="text-primary font-semibold hover:underline">Login</a>
        </p>
    </div>

    <!-- Footer -->
    <p class="mt-6 text-center text-xs text-white/50 fade-up delay-4">
        © @DateTime.UtcNow.Year AcadPrep · All rights reserved
    </p>
</div>


<script>
    // ── Toggle show/hide password ──────────────────────────────────────────
    function wireToggle(btnId, inputId, iconId) {
        const btn  = document.getElementById(btnId);
        const inp  = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (!btn || !inp) { return; }
        btn.addEventListener('click', () => {
            const hidden = inp.type === 'password';
            inp.type = hidden ? 'text' : 'password';
            icon.className = hidden
                ? 'fa-regular fa-eye-slash text-sm'
                : 'fa-regular fa-eye text-sm';
        });
    }
    wireToggle('toggle-password', 'password-input', 'toggle-icon-pw');
    wireToggle('toggle-confirm',  'confirm-password-input', 'toggle-icon-confirm');

    // ── Password strength indicator ────────────────────────────────────────
    const pwInput = document.getElementById('password-input');
    const dots    = [
        document.getElementById('dot-1'),
        document.getElementById('dot-2'),
        document.getElementById('dot-3'),
        document.getElementById('dot-4'),
    ];
    const colors  = ['#ba1a1a', '#e07a00', '#1e88e5', '#006c4c'];

    function getStrength(pw) {
        let score = 0;
        if (pw.length >= 8)                    { score++; }
        if (/[A-Z]/.test(pw))                  { score++; }
        if (/[a-z]/.test(pw) && /\d/.test(pw)) { score++; }
        if (/[^a-zA-Z\d]/.test(pw))            { score++; }
        return score;
    }

    if (pwInput) {
        pwInput.addEventListener('input', () => {
            const s = getStrength(pwInput.value);
            dots.forEach((d, i) => {
                d.style.background = i < s ? colors[Math.min(s - 1, 3)] : '#c7c4d8';
            });
        });
    }

    // ── Confirm password real-time check ───────────────────────────────────
    const confirmInput    = document.getElementById('confirm-password-input');
    const mismatchMsg     = document.getElementById('confirm-mismatch');

    if (confirmInput && pwInput && mismatchMsg) {
        function checkMatch() {
            if (confirmInput.value === '') {
                mismatchMsg.classList.add('hidden');
                return;
            }
            const match = confirmInput.value === pwInput.value;
            mismatchMsg.classList.toggle('hidden', match);
        }
        confirmInput.addEventListener('input', checkMatch);
        pwInput.addEventListener('input', checkMatch);
    }

    // ── Loading state on form submit ───────────────────────────────────────
    const form      = document.getElementById('register-form');
    const btnReg    = document.getElementById('btn-register');

    if (form && btnReg) {
        form.addEventListener('submit', () => {
            btnReg.disabled = true;
            btnReg.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>Processing...';
        });
    }
</script>
</body>
</html>
