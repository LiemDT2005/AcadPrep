<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcadPrep</title>
    <!-- MDB / Bootstrap for styling -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/7.1.0/mdb.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f8f9fa; }
        .navbar { box-shadow: 0 2px 4px rgba(0,0,0,.08); }
    </style>
    <!-- Tailwind CSS (Stitch UI) -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                  "background": "#fcf8ff",
                  "primary": "#1e00a9",
                  "primary-container": "#3525cd",
                  "on-primary": "#ffffff",
                  "on-surface": "#1b1b24",
                  "on-surface-variant": "#464555",
                  "surface-container-lowest": "#ffffff",
                  "surface-container-low": "#f5f2ff",
                  "surface-container": "#efe9f8",
                  "surface-container-high": "#e9e4f0",
                  "surface-variant": "#e5e1ec",
                  "outline": "#787680",
                  "outline-variant": "#c7c4d8",
                  "secondary": "#5e5c71",
                  "secondary-container": "#e4dffa",
                  "on-secondary-container": "#1b1a2c",
                  "tertiary": "#006c4c",
                  "tertiary-container": "#89f8c7",
                  "on-tertiary-container": "#002115",
                  "error": "#ba1a1a",
                  "error-container": "#ffdad6",
                  "on-error-container": "#410002"
              },
              spacing: {
                  "xs": "4px", "sm": "8px", "md": "16px", "lg": "24px", "xl": "32px", "2xl": "48px", "3xl": "64px",
                  "margin-mobile": "16px", "margin-desktop": "40px"
              },
              fontSize: {
                  "display-lg": ["57px", { lineHeight: "64px", letterSpacing: "-0.25px" }],
                  "display-md": ["45px", { lineHeight: "52px" }],
                  "display-sm": ["36px", { lineHeight: "44px" }],
                  "headline-lg": ["32px", { lineHeight: "40px" }],
                  "headline-md": ["28px", { lineHeight: "36px" }],
                  "headline-sm": ["20px", { lineHeight: "28px" }],
                  "body-lg": ["16px", { lineHeight: "24px", letterSpacing: "0.5px" }],
                  "body-md": ["14px", { lineHeight: "20px", letterSpacing: "0.25px" }],
                  "body-sm": ["12px", { lineHeight: "16px", letterSpacing: "0.4px" }],
                  "label-lg": ["14px", { lineHeight: "20px", letterSpacing: "0.1px" }],
                  "label-md": ["12px", { lineHeight: "16px", letterSpacing: "0.5px" }],
                  "label-sm": ["11px", { lineHeight: "16px", letterSpacing: "0.5px" }]
              },
              fontFamily: {
                  "display-lg": ["Inter", "sans-serif"],
                  "display-md": ["Inter", "sans-serif"],
                  "display-sm": ["Inter", "sans-serif"],
                  "headline-lg": ["Inter", "sans-serif"],
                  "headline-md": ["Inter", "sans-serif"],
                  "headline-sm": ["Inter", "sans-serif"],
                  "body-lg": ["Inter", "sans-serif"],
                  "body-md": ["Inter", "sans-serif"],
                  "body-sm": ["Inter", "sans-serif"],
                  "label-lg": ["Inter", "sans-serif"],
                  "label-md": ["Inter", "sans-serif"],
                  "label-sm": ["Inter", "sans-serif"]
              }
            }
          }
        }
    </script>
</head>
<body>
    <!-- TopNavBar (Guest State from Stitch) -->
    <header class="sticky top-0 z-50 bg-surface-container-lowest border-b border-outline-variant w-full h-[64px] mb-4 font-[Inter]">
        <div class="flex justify-between items-center w-full px-margin-desktop max-w-7xl mx-auto h-full">
            <!-- Brand Logo -->
            <a class="flex items-center gap-sm group" href="/" style="text-decoration:none;">
                <span class="material-symbols-outlined text-primary text-[28px]" style="font-variation-settings: 'FILL' 1;">school</span>
                <span class="text-[20px] font-bold text-primary-container leading-[28px]">AcadPrep</span>
            </a>
            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center h-full gap-lg">
                <a class="h-full flex items-center px-sm text-[16px] text-on-surface-variant font-medium hover:text-primary transition-colors" href="/Performance/Dashboard" style="text-decoration:none;">Dashboard</a>
                <a class="h-full flex items-center px-sm text-[16px] text-on-surface-variant font-medium hover:text-primary transition-colors" href="/Performance/Achievements" style="text-decoration:none;">Achievements</a>
                <a class="h-full flex items-center px-sm text-[16px] text-on-surface-variant font-medium hover:text-primary transition-colors" href="/Vocabulary/Notebook" style="text-decoration:none;">Vocabulary</a>
                <a class="h-full flex items-center px-sm text-[16px] text-on-surface-variant font-medium hover:text-primary transition-colors" href="/Admin/Dashboard" style="text-decoration:none;">Admin</a>
            </nav>
            <!-- Trailing Actions -->
            <div class="flex items-center gap-md">
                <button class="hidden sm:inline-flex items-center justify-center px-md py-sm rounded-lg border border-outline-variant text-on-surface text-[14px] font-medium hover:bg-surface-container-low transition-colors duration-100">Log In</button>
                <button class="inline-flex items-center justify-center px-md py-sm rounded-lg bg-primary-container text-white text-[14px] font-medium hover:opacity-90 active:scale-95 transition-all duration-100 shadow-sm border-0">Get Started</button>
                <button class="md:hidden flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors p-sm bg-transparent border-0"><span class="material-symbols-outlined">menu</span></button>
            </div>
        </div>
    </header>
    
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/7.1.0/mdb.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            fetch('/api/achievements/unnotified')
                .then(response => response.json())
                .then(data => {
                    if (data && data.length > 0) {
                        data.forEach(achievement => {
                            Swal.fire({
                                title: 'Congratulations!',
                                text: `You unlocked the badge: ${achievement.name}`,
                                imageUrl: achievement.iconUrl || 'https://cdn-icons-png.flaticon.com/512/1000/1000185.png',
                                imageWidth: 100,
                                imageHeight: 100,
                                confirmButtonText: 'Awesome!'
                            }).then(() => {
                                fetch('/api/achievements/mark-notified', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(achievement.achievementId)
                                });
                            });
                        });
                    }
                });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
