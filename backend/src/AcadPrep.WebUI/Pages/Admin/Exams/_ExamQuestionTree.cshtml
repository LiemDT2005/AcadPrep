@model ExamStructureViewModel
@{
    var exam = Model.Exam;
}
    <!-- Part Accordions (7 items) -->
    <section class="flex flex-col gap-md">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold flex items-center gap-xs">
            <span class="material-symbols-outlined text-primary">list_alt</span>
            Question List by Part
        </h3>

        <!-- PART 1 -->
        <details class="qc-accordion group transition-all duration-300" open>
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 1: Photographs</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Listen & select the correct description for the photograph</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(Model.Part1Count >= ExamStructureViewModel.TargetP1 ? "qc-part-badge-count--complete" : "")">
                    @Model.Part1Count/@ExamStructureViewModel.TargetP1 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (Model.Part1Questions.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-sm">
                        @foreach (var   q in Model.Part1Questions)
                        {
                            <div class="qc-question-item">
                                <div class="flex items-center gap-md flex-1 min-w-0 pr-md">
                                    @if (!string.IsNullOrEmpty(q.ImageUrl))
                                    {
                                        <div class="w-12 h-12 bg-surface-container rounded-lg overflow-hidden shrink-0">
                                            <img src="@q.ImageUrl" alt="@q.QuestionNumber" class="w-full h-full object-cover" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                            <span class="material-symbols-outlined text-md">image</span>
                                        </div>
                                    }
                                    <div class="min-w-0">
                                        <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber)</h5>
                                        <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                        <div class="flex items-center gap-sm mt-xs text-on-surface-variant">
                                            <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">Correct: @q.CorrectOption</span>
                                            @if (!string.IsNullOrEmpty(q.AudioUrl))
                                            {
                                                <span class="material-symbols-outlined text-sm" title="Has Audio">volume_up</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @if (!Model.IsReadOnly)
                                {
                                    <div class="flex shrink-0 gap-xs">
                                    <a href="/Admin/Exams/@exam.Id/Questions/Create/ListeningQuestion?part=1&editId=@q.Id" class="text-primary hover:bg-primary/10 p-2 rounded-lg transition-colors flex items-center justify-center" title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    <button type="button" onclick="confirmDelete('part1', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center" title="Delete">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 1 questions yet.</p>
                    </div>
                }
                @if (!Model.IsReadOnly && Model.CanAddP1)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/ListeningQuestion?part=1" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Question
                        </a>
                    </div>
                }
                else if (!Model.CanAddP1)
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 1 is complete (@ExamStructureViewModel.TargetP1/@ExamStructureViewModel.TargetP1 questions).</p>
                }
            </div>
        </details>

        <!-- PART 2 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 2: Question-Response</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Listen to a question and 3 response options</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(Model.Part2Count >= ExamStructureViewModel.TargetP2 ? "qc-part-badge-count--complete" : "")">
                    @Model.Part2Count/@ExamStructureViewModel.TargetP2 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (Model.Part2Questions.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-sm">
                        @foreach (var q in Model.Part2Questions)
                        {
                            <div class="qc-question-item">
                                <div class="flex items-center gap-md flex-1 min-w-0 pr-md">
                                    <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined text-md">hearing</span>
                                    </div>
                                    <div class="min-w-0">
                                        <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber)</h5>
                                        <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                        <div class="flex items-center gap-sm mt-xs text-on-surface-variant">
                                            <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">Correct: @q.CorrectOption</span>
                                            @if (!string.IsNullOrEmpty(q.AudioUrl))
                                            {
                                                <span class="material-symbols-outlined text-sm" title="Has Audio">volume_up</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @if (!Model.IsReadOnly)
                                {
                                    <div class="flex shrink-0 gap-xs">
                                    <a href="/Admin/Exams/@exam.Id/Questions/Create/ListeningQuestion?part=2&editId=@q.Id" class="text-primary hover:bg-primary/10 p-2 rounded-lg transition-colors flex items-center justify-center" title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    <button type="button" onclick="confirmDelete('part2', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center" title="Delete">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 2 questions yet.</p>
                    </div>
                }
                @if (!Model.IsReadOnly && Model.CanAddP2)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/ListeningQuestion?part=2" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Question
                        </a>
                    </div>
                }
                else if (!Model.CanAddP2)
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 2 is complete (@ExamStructureViewModel.TargetP2/@ExamStructureViewModel.TargetP2 questions).</p>
                }
            </div>
        </details>

        <!-- PART 3 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 3: Conversations</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Listen to a short conversation between 2-3 people and answer 3 questions</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(Model.Part3Count >= ExamStructureViewModel.TargetP3 ? "qc-part-badge-count--complete" : "")">
                    @Model.Part3Count/@ExamStructureViewModel.TargetP3 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (Model.Part3Groups.Any())
                {
                    <div class="flex flex-col gap-sm">
                        @foreach (var g in Model.Part3Groups)
                        {
                            var qList = g.OrderBy(q => q.QuestionNumber).ToList();
                            if (!g.Key.HasValue)
                            {
                                foreach (var q in qList)
                                {
                                    <div class="qc-question-item">
                                        <div class="flex items-center gap-md flex-1 min-w-0 pr-md">
                                            <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                                <span class="material-symbols-outlined text-md">forum</span>
                                            </div>
                                            <div class="min-w-0">
                                                <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber) (standalone)</h5>
                                                <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                            </div>
                                        </div>
                                        @if (!Model.IsReadOnly)
                                        {
                                            <button type="button" onclick="confirmDelete('question', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                        }
                                    </div>
                                }
                                continue;
                            }

                            var min = qList.First().QuestionNumber;
                            var max = qList.Last().QuestionNumber;
                            var label = $"Q{min}–{max}";
                            var firstAudio = qList.FirstOrDefault(q => !string.IsNullOrEmpty(q.AudioUrl))?.AudioUrl;
                            
                            <div class="qc-question-item">
                                <div class="flex items-center gap-md">
                                    <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined text-md">forum</span>
                                    </div>
                                    <div>
                                        <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Conversation (@label)</h5>
                                        <div class="flex items-center gap-sm mt-xs text-on-surface-variant">
                                            <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">@qList.Count questions</span>
                                            @if (!string.IsNullOrEmpty(firstAudio))
                                            {
                                                <span class="material-symbols-outlined text-sm" title="Has Audio">volume_up</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @if (!Model.IsReadOnly)
                                {
                                    <div class="flex gap-sm shrink-0">
                                    <a href="/Admin/Exams/@exam.Id/Questions/Create/Listening?part=3&groupId=@(g.Key ?? 0)" class="text-primary hover:bg-primary/10 p-2 rounded-lg transition-colors flex items-center justify-center" title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    <button type="button" onclick="confirmDelete('listening', @(g.Key ?? 0), 'Conversation @label')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center" title="Delete">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 3 questions yet.</p>
                    </div>
                }
                @if (!Model.IsReadOnly && Model.CanAddP3)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/Listening?part=3" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Listening Group
                        </a>
                    </div>
                }
                else if (!Model.CanAddP3)
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 3 is complete (@ExamStructureViewModel.TargetP3/@ExamStructureViewModel.TargetP3 questions).</p>
                }
            </div>
        </details>

        <!-- PART 4 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 4: Talks</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Listen to a short talk and answer 3 questions</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(Model.Part4Count >= ExamStructureViewModel.TargetP4 ? "qc-part-badge-count--complete" : "")">
                    @Model.Part4Count/@ExamStructureViewModel.TargetP4 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (Model.Part4Groups.Any())
                {
                    <div class="flex flex-col gap-sm">
                        @foreach (var g in Model.Part4Groups)
                        {
                            var qList = g.OrderBy(q => q.QuestionNumber).ToList();
                            if (!g.Key.HasValue)
                            {
                                foreach (var q in qList)
                                {
                                    <div class="qc-question-item">
                                        <div class="flex items-center gap-md flex-1 min-w-0 pr-md">
                                            <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                                <span class="material-symbols-outlined text-md">record_voice_over</span>
                                            </div>
                                            <div class="min-w-0">
                                                <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber) (standalone)</h5>
                                                <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                            </div>
                                        </div>
                                        @if (!Model.IsReadOnly)
                                        {
                                            <button type="button" onclick="confirmDelete('question', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                        }
                                    </div>
                                }
                                continue;
                            }

                            var min = qList.First().QuestionNumber;
                            var max = qList.Last().QuestionNumber;
                            var label = $"Q{min}–{max}";
                            var firstAudio = qList.FirstOrDefault(q => !string.IsNullOrEmpty(q.AudioUrl))?.AudioUrl;
                            
                            <div class="qc-question-item">
                                <div class="flex items-center gap-md">
                                    <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined text-md">record_voice_over</span>
                                    </div>
                                    <div>
                                        <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Short Talk (@label)</h5>
                                        <div class="flex items-center gap-sm mt-xs text-on-surface-variant">
                                            <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">@qList.Count questions</span>
                                            @if (!string.IsNullOrEmpty(firstAudio))
                                            {
                                                <span class="material-symbols-outlined text-sm" title="Has Audio">volume_up</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @if (!Model.IsReadOnly)
                                {
                                    <div class="flex gap-sm shrink-0">
                                    <a href="/Admin/Exams/@exam.Id/Questions/Create/Listening?part=4&groupId=@(g.Key ?? 0)" class="text-primary hover:bg-primary/10 p-2 rounded-lg transition-colors flex items-center justify-center" title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    <button type="button" onclick="confirmDelete('listening', @(g.Key ?? 0), 'Short Talk @label')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center" title="Delete">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 4 questions yet.</p>
                    </div>
                }
                @if (!Model.IsReadOnly && Model.CanAddP4)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/Listening?part=4" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Listening Group
                        </a>
                    </div>
                }
                else if (!Model.CanAddP4)
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 4 is complete (@ExamStructureViewModel.TargetP4/@ExamStructureViewModel.TargetP4 questions).</p>
                }
            </div>
        </details>

        <!-- PART 5 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 5: Incomplete Sentences</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Standalone questions, fill in the blank with the correct option</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(Model.Part5Count >= ExamStructureViewModel.TargetP5 ? "qc-part-badge-count--complete" : "")">
                    @Model.Part5Count/@ExamStructureViewModel.TargetP5 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (Model.Part5Questions.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-sm">
                        @foreach (var q in Model.Part5Questions)
                        {
                            <div class="qc-question-item">
                                <div class="flex-1 min-w-0 pr-md">
                                    <span class="font-label-sm text-label-sm font-semibold text-primary">Q@(q.QuestionNumber):</span>
                                    <p class="font-body-sm text-body-sm text-on-surface line-clamp-1 mt-xs">@q.QuestionText</p>
                                    <div class="flex items-center gap-sm mt-xs">
                                        <span class="font-body-xs text-body-xs font-semibold text-tertiary bg-tertiary-fixed/20 p-1 px-2 rounded-full">Correct Option: @q.CorrectOption</span>
                                        @if (!string.IsNullOrEmpty(q.QuestionType))
                                        {
                                            <span class="font-body-xs text-body-xs text-on-surface-variant bg-surface-container p-0.5 px-2 rounded">@q.QuestionType</span>
                                        }
                                    </div>
                                </div>
                                @if (!Model.IsReadOnly)
                                {
                                    <div class="flex shrink-0 gap-xs">
                                    <a href="/Admin/Exams/@exam.Id/Questions/Create/Part5?editId=@q.Id" class="text-primary hover:bg-primary/10 p-2 rounded-lg transition-colors flex items-center justify-center" title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    <button type="button" onclick="confirmDelete('part5', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center" title="Delete">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 5 questions yet.</p>
                    </div>
                }
                @if (!Model.IsReadOnly && Model.CanAddP5)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/Part5" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Standalone Question
                        </a>
                    </div>
                }
                else if (!Model.CanAddP5)
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 5 is complete (@ExamStructureViewModel.TargetP5/@ExamStructureViewModel.TargetP5 questions).</p>
                }
            </div>
        </details>

        <!-- PART 6 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 6: Text Completion</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">A reading passage with 4 blank spaces to fill in</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(Model.Part6Count >= ExamStructureViewModel.TargetP6 ? "qc-part-badge-count--complete" : "")">
                    @Model.Part6Count/@ExamStructureViewModel.TargetP6 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (Model.Part6Groups.Any())
                {
                    <div class="flex flex-col gap-sm">
                        @foreach (var g in Model.Part6Groups)
                        {
                            var qList = g.OrderBy(q => q.QuestionNumber).ToList();
                            if (!g.Key.HasValue)
                            {
                                foreach (var q in qList)
                                {
                                    <div class="qc-question-item">
                                        <div class="flex-1 min-w-0 pr-md">
                                            <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber) (standalone)</h5>
                                            <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                        </div>
                                        @if (!Model.IsReadOnly)
                                        {
                                            <button type="button" onclick="confirmDelete('question', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                        }
                                    </div>
                                }
                                continue;
                            }

                            var min = qList.First().QuestionNumber;
                            var max = qList.Last().QuestionNumber;
                            var label = $"Q{min}–{max}";
                            var passageOrder = qList.FirstOrDefault()?.PassageDisplayOrder;
                            var passageLabel = passageOrder.HasValue ? $"Passage {passageOrder}" : "Passage";
                            var textPreview = qList.FirstOrDefault()?.PassageContent;
                            
                            <div class="qc-question-item">
                                <div class="flex-1 min-w-0 pr-md">
                                    <h5 class="font-title-sm text-title-sm font-semibold text-on-surface flex items-center gap-xs">
                                        <span class="material-symbols-outlined text-primary text-sm">article</span>
                                        Text Completion @passageLabel (@label)
                                    </h5>
                                    @if (!string.IsNullOrEmpty(textPreview))
                                    {
                                        <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-1 mt-xs italic">"@textPreview"</p>
                                    }
                                </div>
                                @if (!Model.IsReadOnly)
                                {
                                    <div class="flex shrink-0 gap-xs">
                                    <a href="/Admin/Exams/@exam.Id/Questions/Create/Part6?passageId=@(g.Key ?? 0)" class="text-primary hover:bg-primary/10 p-2 rounded-lg transition-colors flex items-center justify-center" title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    <button type="button" onclick="confirmDelete('textcompletion', @(g.Key ?? 0), 'Passage @label')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center" title="Delete">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                                }
                            </div>
                        }
                    </div>  
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 6 passages yet.</p>
                    </div>
                }
                @if (!Model.IsReadOnly && Model.CanAddP6)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/Part6" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Passage
                        </a>
                    </div>
                }
                else if (!Model.CanAddP6)
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 6 is complete (@ExamStructureViewModel.TargetP6/@ExamStructureViewModel.TargetP6 questions).</p>
                }
            </div>
        </details>

        <!-- PART 7 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 7: Reading Comprehension</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Read 1-3 passages and answer 2-5 corresponding questions</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(Model.Part7Count >= ExamStructureViewModel.TargetP7 ? "qc-part-badge-count--complete" : "")">
                    @Model.Part7Count/@ExamStructureViewModel.TargetP7 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (Model.Part7Sets.Any() || Model.Part7Orphans.Any())
                {
                    <div class="flex flex-col gap-sm">
                        @foreach (var q in Model.Part7Orphans)
                        {
                            <div class="qc-question-item">
                                <div class="flex-1 min-w-0 pr-md">
                                    <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber) (standalone)</h5>
                                    <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                </div>
                                @if (!Model.IsReadOnly)
                                        {
                                            <button type="button" onclick="confirmDelete('question', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </button>
                                        }
                            </div>
                        }
                        @foreach (var s in Model.Part7Sets)
                        {
                            var qList = s.Questions.OrderBy(q => q.QuestionNumber).ToList();
                            var min = qList.Any() ? qList.First().QuestionNumber.ToString() : "?";
                            var max = qList.Any() ? qList.Last().QuestionNumber.ToString() : "?";
                            var label = qList.Count > 1 ? $"Q{min}–{max}" : $"Q{min}";
                            
                            <div class="qc-question-item">
                                <div class="flex-1 min-w-0 pr-md">
                                    <h5 class="font-title-sm text-title-sm font-semibold text-on-surface flex items-center gap-xs">
                                        <span class="material-symbols-outlined text-primary text-sm">menu_book</span>
                                        @s.Name (@label)
                                    </h5>
                                    <div class="flex items-center gap-sm mt-xs text-on-surface-variant">
                                        <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">@s.Passages.Count passages</span>
                                        <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">@s.Questions.Count questions</span>
                                    </div>
                                </div>
                                @if (!Model.IsReadOnly)
                                {
                                    <div class="flex shrink-0 gap-xs">
                                    <a href="/Admin/Exams/@exam.Id/Questions/Create/Part7?groupId=@s.QuestionGroupId" class="text-primary hover:bg-primary/10 p-2 rounded-lg transition-colors flex items-center justify-center" title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    <button type="button" onclick="confirmDelete('readingset', @s.QuestionGroupId, '@s.Name (@label)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center" title="Delete">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 7 reading sets yet.</p>
                    </div>
                }
                @if (!Model.IsReadOnly && Model.CanAddP7)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/Part7" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Reading Set
                        </a>
                    </div>
                }
                else if (!Model.CanAddP7)
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 7 is complete (@ExamStructureViewModel.TargetP7/@ExamStructureViewModel.TargetP7 questions).</p>
                }
            </div>
        </details>
    </section>

