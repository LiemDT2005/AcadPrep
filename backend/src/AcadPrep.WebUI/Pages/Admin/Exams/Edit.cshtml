@page
@model AcadPrep.WebUI.Pages.Admin.Exams.EditModel
@{
    Layout = "_ModeratorLayout";
    ViewData["Title"] = "Manage Questions - " + Model.Exam.Title;

    var exam = Model.Exam;
    
    // Grouping questions for display
    var part1Questions = exam.Questions.Where(q => q.Part == 1).OrderBy(q => q.QuestionNumber).ToList();
    var part2Questions = exam.Questions.Where(q => q.Part == 2).OrderBy(q => q.QuestionNumber).ToList();
    var part3Groups = exam.Questions.Where(q => q.Part == 3).GroupBy(q => q.QuestionGroupId).ToList();
    var part4Groups = exam.Questions.Where(q => q.Part == 4).GroupBy(q => q.QuestionGroupId).ToList();
    var part5Questions = exam.Questions.Where(q => q.Part == 5).OrderBy(q => q.QuestionNumber).ToList();
    var part6Groups = exam.Questions.Where(q => q.Part == 6).GroupBy(q => q.PassageId)
        .OrderBy(g => g.Min(q => q.PassageDisplayOrder ?? q.QuestionNumber))
        .ToList();
    var part7Sets = exam.Part7ReadingSets;
    var part7Orphans = exam.Questions.Where(q => q.Part == 7 && !q.QuestionGroupId.HasValue).OrderBy(q => q.QuestionNumber).ToList();

    // Counts
    var part1Count = exam.Questions.Count(q => q.Part == 1);
    var part2Count = exam.Questions.Count(q => q.Part == 2);
    var part3Count = exam.Questions.Count(q => q.Part == 3);
    var part4Count = exam.Questions.Count(q => q.Part == 4);
    var part5Count = exam.Questions.Count(q => q.Part == 5);
    var part6Count = exam.Questions.Count(q => q.Part == 6);
    var part7Count = part7Sets.Sum(s => s.Questions.Count) + part7Orphans.Count;
    
    var totalQuestions = part1Count + part2Count + part3Count + part4Count + part5Count + part6Count + part7Count;

    // Target counts
    var targetP1 = 6;
    var targetP2 = 25;
    var targetP3 = 39;
    var targetP4 = 30;
    var targetP5 = 30;
    var targetP6 = 16;
    var targetP7 = 54;

    var canAddP1 = part1Count < targetP1;
    var canAddP2 = part2Count < targetP2;
    var canAddP3 = part3Count + 3 <= targetP3;
    var canAddP4 = part4Count + 3 <= targetP4;
    var canAddP5 = part5Count < targetP5;
    var canAddP6 = part6Count + 4 <= targetP6;
    var canAddP7 = part7Count + 2 <= targetP7;
}

<link rel="stylesheet" href="~/css/admin-question-create.css" />

<div class="w-full flex flex-col gap-lg pb-12">
    <!-- Page Hero -->
    <div class="qc-page-hero">
        <nav class="qc-breadcrumb" aria-label="Breadcrumb">
            <a href="/Admin/Exams">Exams</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="qc-breadcrumb-current">Manage Questions</span>
        </nav>
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-md">
            <div class="flex items-start gap-md">
                <div class="hidden sm:flex w-12 h-12 rounded-xl bg-primary/10 items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-primary text-[28px]">edit_note</span>
                </div>
                <div>
                    <span class="font-label-sm text-label-sm text-outline-variant font-semibold">EXAM ID: #@exam.Id</span>
                    <h1 class="font-headline-lg text-headline-lg font-bold text-on-surface mt-2xs">@exam.Title</h1>
                    @if (!string.IsNullOrEmpty(exam.Description))
                    {
                        <p class="font-body-md text-body-md text-on-surface-variant mt-sm max-w-2xl">@exam.Description</p>
                    }
                    <div class="flex items-center gap-sm mt-sm">
                        <span class="qc-part-badge qc-part-badge--primary">
                            <span class="material-symbols-outlined text-[14px]">schedule</span>
                            @exam.Duration minutes
                        </span>
                        <span class="qc-part-badge qc-part-badge--tertiary">
                            <span class="material-symbols-outlined text-[14px]">quiz</span>
                            @totalQuestions questions
                        </span>
                    </div>
                </div>
            </div>
            <div class="flex gap-sm self-start">
                <a href="/Admin/Exams/Detail?id=@exam.Id" class="qc-btn-ghost">View Details</a>
                <button type="button" onclick="openPartPicker()" class="qc-btn-primary">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    Add Content
                </button>
            </div>
        </div>
    </div>

    <!-- Notifications -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-tertiary-fixed/20 border border-tertiary text-on-tertiary-fixed-variant rounded-xl p-md flex items-center gap-sm shadow-sm animate-fade-in">
            <span class="material-symbols-outlined text-tertiary">check_circle</span>
            <span class="font-body-md">@Model.SuccessMessage</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-error-container border border-error text-on-error-container rounded-xl p-md flex items-center gap-sm shadow-sm animate-fade-in">
            <span class="material-symbols-outlined text-error">error</span>
            <span class="font-body-md">@Model.ErrorMessage</span>
        </div>
    }

    <!-- Structural Progress Indicator -->
    <section class="qc-form-card">
        <div class="qc-section__header" style="margin-bottom:0.75rem;padding-bottom:0.75rem">
            <span class="material-symbols-outlined">analytics</span>
            <div>
                <div class="qc-section__title">Exam Structure Progress</div>
                <div class="qc-section__hint">Track completion across all 7 TOEIC parts</div>
            </div>
            <span class="qc-part-badge qc-part-badge--primary ml-auto">
                @totalQuestions total
            </span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-7 gap-md">
            <!-- Part 1 -->
            <div class="qc-progress-card @(part1Count > 0 ? "qc-progress-card--active" : "") @(part1Count >= targetP1 ? "qc-progress-card--complete" : "")">
                <div class="flex justify-between items-center font-label-sm text-label-sm font-semibold">
                    <span class="text-on-surface">Part 1</span>
                    <span class="text-on-surface-variant">@part1Count/@targetP1</span>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-300 @(part1Count >= targetP1 ? "bg-tertiary" : part1Count > 0 ? "bg-primary" : "bg-outline-variant/40")" style="width: @(Math.Min(100, (part1Count * 100) / targetP1))%"></div>
                </div>
            </div>

            <!-- Part 2 -->
            <div class="qc-progress-card @(part2Count > 0 ? "qc-progress-card--active" : "") @(part2Count >= targetP2 ? "qc-progress-card--complete" : "")">
                <div class="flex justify-between items-center font-label-sm text-label-sm font-semibold">
                    <span class="text-on-surface">Part 2</span>
                    <span class="text-on-surface-variant">@part2Count/@targetP2</span>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-300 @(part2Count >= targetP2 ? "bg-tertiary" : part2Count > 0 ? "bg-primary" : "bg-outline-variant/40")" style="width: @(Math.Min(100, (part2Count * 100) / targetP2))%"></div>
                </div>
            </div>

            <!-- Part 3 -->
            <div class="qc-progress-card @(part3Count > 0 ? "qc-progress-card--active" : "") @(part3Count >= targetP3 ? "qc-progress-card--complete" : "")">
                <div class="flex justify-between items-center font-label-sm text-label-sm font-semibold">
                    <span class="text-on-surface">Part 3</span>
                    <span class="text-on-surface-variant">@part3Count/@targetP3</span>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-300 @(part3Count >= targetP3 ? "bg-tertiary" : part3Count > 0 ? "bg-primary" : "bg-outline-variant/40")" style="width: @(Math.Min(100, (part3Count * 100) / targetP3))%"></div>
                </div>
            </div>

            <!-- Part 4 -->
            <div class="qc-progress-card @(part4Count > 0 ? "qc-progress-card--active" : "") @(part4Count >= targetP4 ? "qc-progress-card--complete" : "")">
                <div class="flex justify-between items-center font-label-sm text-label-sm font-semibold">
                    <span class="text-on-surface">Part 4</span>
                    <span class="text-on-surface-variant">@part4Count/@targetP4</span>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-300 @(part4Count >= targetP4 ? "bg-tertiary" : part4Count > 0 ? "bg-primary" : "bg-outline-variant/40")" style="width: @(Math.Min(100, (part4Count * 100) / targetP4))%"></div>
                </div>
            </div>

            <!-- Part 5 -->
            <div class="qc-progress-card @(part5Count > 0 ? "qc-progress-card--active" : "") @(part5Count >= targetP5 ? "qc-progress-card--complete" : "")">
                <div class="flex justify-between items-center font-label-sm text-label-sm font-semibold">
                    <span class="text-on-surface">Part 5</span>
                    <span class="text-on-surface-variant">@part5Count/@targetP5</span>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-300 @(part5Count >= targetP5 ? "bg-tertiary" : part5Count > 0 ? "bg-primary" : "bg-outline-variant/40")" style="width: @(Math.Min(100, (part5Count * 100) / targetP5))%"></div>
                </div>
            </div>

            <!-- Part 6 -->
            <div class="qc-progress-card @(part6Count > 0 ? "qc-progress-card--active" : "") @(part6Count >= targetP6 ? "qc-progress-card--complete" : "")">
                <div class="flex justify-between items-center font-label-sm text-label-sm font-semibold">
                    <span class="text-on-surface">Part 6</span>
                    <span class="text-on-surface-variant">@part6Count/@targetP6</span>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-300 @(part6Count >= targetP6 ? "bg-tertiary" : part6Count > 0 ? "bg-primary" : "bg-outline-variant/40")" style="width: @(Math.Min(100, (part6Count * 100) / targetP6))%"></div>
                </div>
            </div>

            <!-- Part 7 -->
            <div class="qc-progress-card @(part7Count > 0 ? "qc-progress-card--active" : "") @(part7Count >= targetP7 ? "qc-progress-card--complete" : "")">
                <div class="flex justify-between items-center font-label-sm text-label-sm font-semibold">
                    <span class="text-on-surface">Part 7</span>
                    <span class="text-on-surface-variant">@part7Count/@targetP7</span>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-300 @(part7Count >= targetP7 ? "bg-tertiary" : part7Count > 0 ? "bg-primary" : "bg-outline-variant/40")" style="width: @(Math.Min(100, (part7Count * 100) / targetP7))%"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Part Accordions (7 items) -->
    <section class="flex flex-col gap-md">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold flex items-center gap-xs">
            <span class="material-symbols-outlined text-primary">list_alt</span>
            Question List by Part
        </h3>

        <!-- PART 1 -->
        <details class="qc-accordion group transition-all duration-300" open>
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 1: Photographs</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Listen & select the correct description for the photograph</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(part1Count >= targetP1 ? "qc-part-badge-count--complete" : "")">
                    @part1Count/@targetP1 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (part1Questions.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-sm">
                        @foreach (var   q in part1Questions)
                        {
                            <div class="qc-question-item">
                                <div class="flex items-center gap-md flex-1 min-w-0 pr-md">
                                    @if (!string.IsNullOrEmpty(q.ImageUrl))
                                    {
                                        <div class="w-12 h-12 bg-surface-container rounded-lg overflow-hidden shrink-0">
                                            <img src="@q.ImageUrl" alt="@q.QuestionNumber" class="w-full h-full object-cover" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                            <span class="material-symbols-outlined text-md">image</span>
                                        </div>
                                    }
                                    <div class="min-w-0">
                                        <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber)</h5>
                                        <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                        <div class="flex items-center gap-sm mt-xs text-on-surface-variant">
                                            <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">Correct: @q.CorrectOption</span>
                                            @if (!string.IsNullOrEmpty(q.AudioUrl))
                                            {
                                                <span class="material-symbols-outlined text-sm" title="Has Audio">volume_up</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="flex shrink-0">
                                    <button type="button" onclick="confirmDelete('part1', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 1 questions yet.</p>
                    </div>
                }
                @if (canAddP1)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/ListeningQuestion?part=1" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Question
                        </a>
                    </div>
                }
                else
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 1 is complete (@targetP1/@targetP1 questions).</p>
                }
            </div>
        </details>

        <!-- PART 2 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 2: Question-Response</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Listen to a question and 3 response options</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(part2Count >= targetP2 ? "qc-part-badge-count--complete" : "")">
                    @part2Count/@targetP2 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (part2Questions.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-sm">
                        @foreach (var q in part2Questions)
                        {
                            <div class="qc-question-item">
                                <div class="flex items-center gap-md flex-1 min-w-0 pr-md">
                                    <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined text-md">hearing</span>
                                    </div>
                                    <div class="min-w-0">
                                        <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber)</h5>
                                        <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                        <div class="flex items-center gap-sm mt-xs text-on-surface-variant">
                                            <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">Correct: @q.CorrectOption</span>
                                            @if (!string.IsNullOrEmpty(q.AudioUrl))
                                            {
                                                <span class="material-symbols-outlined text-sm" title="Has Audio">volume_up</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="flex shrink-0">
                                    <button type="button" onclick="confirmDelete('part2', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 2 questions yet.</p>
                    </div>
                }
                @if (canAddP2)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/ListeningQuestion?part=2" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Question
                        </a>
                    </div>
                }
                else
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 2 is complete (@targetP2/@targetP2 questions).</p>
                }
            </div>
        </details>

        <!-- PART 3 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 3: Conversations</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Listen to a short conversation between 2-3 people and answer 3 questions</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(part3Count >= targetP3 ? "qc-part-badge-count--complete" : "")">
                    @part3Count/@targetP3 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (part3Groups.Any())
                {
                    <div class="flex flex-col gap-sm">
                        @foreach (var g in part3Groups)
                        {
                            var qList = g.OrderBy(q => q.QuestionNumber).ToList();
                            if (!g.Key.HasValue)
                            {
                                foreach (var q in qList)
                                {
                                    <div class="qc-question-item">
                                        <div class="flex items-center gap-md flex-1 min-w-0 pr-md">
                                            <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                                <span class="material-symbols-outlined text-md">forum</span>
                                            </div>
                                            <div class="min-w-0">
                                                <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber) (standalone)</h5>
                                                <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                            </div>
                                        </div>
                                        <button type="button" onclick="confirmDelete('question', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                    </div>
                                }
                                continue;
                            }

                            var min = qList.First().QuestionNumber;
                            var max = qList.Last().QuestionNumber;
                            var label = $"Q{min}–{max}";
                            var firstAudio = qList.FirstOrDefault(q => !string.IsNullOrEmpty(q.AudioUrl))?.AudioUrl;
                            
                            <div class="qc-question-item">
                                <div class="flex items-center gap-md">
                                    <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined text-md">forum</span>
                                    </div>
                                    <div>
                                        <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Conversation (@label)</h5>
                                        <div class="flex items-center gap-sm mt-xs text-on-surface-variant">
                                            <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">@qList.Count questions</span>
                                            @if (!string.IsNullOrEmpty(firstAudio))
                                            {
                                                <span class="material-symbols-outlined text-sm" title="Has Audio">volume_up</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="flex gap-sm">
                                    <button type="button" onclick="confirmDelete('listening', @(g.Key ?? 0), 'Conversation @label')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 3 questions yet.</p>
                    </div>
                }
                @if (canAddP3)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/Listening?part=3" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Listening Group
                        </a>
                    </div>
                }
                else
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 3 is complete (@targetP3/@targetP3 questions).</p>
                }
            </div>
        </details>

        <!-- PART 4 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 4: Talks</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Listen to a short talk and answer 3 questions</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(part4Count >= targetP4 ? "qc-part-badge-count--complete" : "")">
                    @part4Count/@targetP4 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (part4Groups.Any())
                {
                    <div class="flex flex-col gap-sm">
                        @foreach (var g in part4Groups)
                        {
                            var qList = g.OrderBy(q => q.QuestionNumber).ToList();
                            if (!g.Key.HasValue)
                            {
                                foreach (var q in qList)
                                {
                                    <div class="qc-question-item">
                                        <div class="flex items-center gap-md flex-1 min-w-0 pr-md">
                                            <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                                <span class="material-symbols-outlined text-md">record_voice_over</span>
                                            </div>
                                            <div class="min-w-0">
                                                <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber) (standalone)</h5>
                                                <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                            </div>
                                        </div>
                                        <button type="button" onclick="confirmDelete('question', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                    </div>
                                }
                                continue;
                            }

                            var min = qList.First().QuestionNumber;
                            var max = qList.Last().QuestionNumber;
                            var label = $"Q{min}–{max}";
                            var firstAudio = qList.FirstOrDefault(q => !string.IsNullOrEmpty(q.AudioUrl))?.AudioUrl;
                            
                            <div class="qc-question-item">
                                <div class="flex items-center gap-md">
                                    <div class="w-12 h-12 bg-surface-container rounded-lg flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined text-md">record_voice_over</span>
                                    </div>
                                    <div>
                                        <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Short Talk (@label)</h5>
                                        <div class="flex items-center gap-sm mt-xs text-on-surface-variant">
                                            <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">@qList.Count questions</span>
                                            @if (!string.IsNullOrEmpty(firstAudio))
                                            {
                                                <span class="material-symbols-outlined text-sm" title="Has Audio">volume_up</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="flex gap-sm">
                                    <button type="button" onclick="confirmDelete('listening', @(g.Key ?? 0), 'Short Talk @label')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 4 questions yet.</p>
                    </div>
                }
                @if (canAddP4)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/Listening?part=4" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Listening Group
                        </a>
                    </div>
                }
                else
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 4 is complete (@targetP4/@targetP4 questions).</p>
                }
            </div>
        </details>

        <!-- PART 5 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 5: Incomplete Sentences</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Standalone questions, fill in the blank with the correct option</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(part5Count >= targetP5 ? "qc-part-badge-count--complete" : "")">
                    @part5Count/@targetP5 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (part5Questions.Any())
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-sm">
                        @foreach (var q in part5Questions)
                        {
                            <div class="qc-question-item">
                                <div class="flex-1 min-w-0 pr-md">
                                    <span class="font-label-sm text-label-sm font-semibold text-primary">Q@(q.QuestionNumber):</span>
                                    <p class="font-body-sm text-body-sm text-on-surface line-clamp-1 mt-xs">@q.QuestionText</p>
                                    <div class="flex items-center gap-sm mt-xs">
                                        <span class="font-body-xs text-body-xs font-semibold text-tertiary bg-tertiary-fixed/20 p-1 px-2 rounded-full">Correct Option: @q.CorrectOption</span>
                                        @if (!string.IsNullOrEmpty(q.QuestionType))
                                        {
                                            <span class="font-body-xs text-body-xs text-on-surface-variant bg-surface-container p-0.5 px-2 rounded">@q.QuestionType</span>
                                        }
                                    </div>
                                </div>
                                <div class="flex shrink-0">
                                    <button type="button" onclick="confirmDelete('part5', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 5 questions yet.</p>
                    </div>
                }
                @if (canAddP5)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/Part5" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Standalone Question
                        </a>
                    </div>
                }
                else
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 5 is complete (@targetP5/@targetP5 questions).</p>
                }
            </div>
        </details>

        <!-- PART 6 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 6: Text Completion</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">A reading passage with 4 blank spaces to fill in</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(part6Count >= targetP6 ? "qc-part-badge-count--complete" : "")">
                    @part6Count/@targetP6 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (part6Groups.Any())
                {
                    <div class="flex flex-col gap-sm">
                        @foreach (var g in part6Groups)
                        {
                            var qList = g.OrderBy(q => q.QuestionNumber).ToList();
                            if (!g.Key.HasValue)
                            {
                                foreach (var q in qList)
                                {
                                    <div class="qc-question-item">
                                        <div class="flex-1 min-w-0 pr-md">
                                            <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber) (standalone)</h5>
                                            <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                        </div>
                                        <button type="button" onclick="confirmDelete('question', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                        </button>
                                    </div>
                                }
                                continue;
                            }

                            var min = qList.First().QuestionNumber;
                            var max = qList.Last().QuestionNumber;
                            var label = $"Q{min}–{max}";
                            var passageOrder = qList.FirstOrDefault()?.PassageDisplayOrder;
                            var passageLabel = passageOrder.HasValue ? $"Passage {passageOrder}" : "Passage";
                            var textPreview = qList.FirstOrDefault()?.PassageContent;
                            
                            <div class="qc-question-item">
                                <div class="flex-1 min-w-0 pr-md">
                                    <h5 class="font-title-sm text-title-sm font-semibold text-on-surface flex items-center gap-xs">
                                        <span class="material-symbols-outlined text-primary text-sm">article</span>
                                        Text Completion @passageLabel (@label)
                                    </h5>
                                    @if (!string.IsNullOrEmpty(textPreview))
                                    {
                                        <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-1 mt-xs italic">"@textPreview"</p>
                                    }
                                </div>
                                <div class="flex shrink-0">
                                    <button type="button" onclick="confirmDelete('textcompletion', @(g.Key ?? 0), 'Passage @label')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>  
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 6 passages yet.</p>
                    </div>
                }
                @if (canAddP6)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/Part6" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Passage
                        </a>
                    </div>
                }
                else
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 6 is complete (@targetP6/@targetP6 questions).</p>
                }
            </div>
        </details>

        <!-- PART 7 -->
        <details class="qc-accordion group transition-all duration-300">
            <summary class="flex justify-between items-center p-md cursor-pointer select-none hover:bg-surface-container-low transition-colors list-none">
                <div class="flex items-center gap-md">
                    <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
                    <div>
                        <h4 class="font-title-md text-title-md font-bold text-on-surface">Part 7: Reading Comprehension</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">Read 1-3 passages and answer 2-5 corresponding questions</p>
                    </div>
                </div>
                <span class="qc-part-badge-count @(part7Count >= targetP7 ? "qc-part-badge-count--complete" : "")">
                    @part7Count/@targetP7 questions
                </span>
            </summary>
            <div class="qc-accordion__body">
                @if (part7Sets.Any() || part7Orphans.Any())
                {
                    <div class="flex flex-col gap-sm">
                        @foreach (var q in part7Orphans)
                        {
                            <div class="qc-question-item">
                                <div class="flex-1 min-w-0 pr-md">
                                    <h5 class="font-title-sm text-title-sm font-semibold text-on-surface">Q@(q.QuestionNumber) (standalone)</h5>
                                    <p class="font-body-xs text-body-xs text-on-surface-variant line-clamp-1 mt-3xs">@q.QuestionText</p>
                                </div>
                                <button type="button" onclick="confirmDelete('question', @q.Id, 'Q@(q.QuestionNumber)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </button>
                            </div>
                        }
                        @foreach (var s in part7Sets)
                        {
                            var qList = s.Questions.OrderBy(q => q.QuestionNumber).ToList();
                            var min = qList.Any() ? qList.First().QuestionNumber.ToString() : "?";
                            var max = qList.Any() ? qList.Last().QuestionNumber.ToString() : "?";
                            var label = qList.Count > 1 ? $"Q{min}–{max}" : $"Q{min}";
                            
                            <div class="qc-question-item">
                                <div class="flex-1 min-w-0 pr-md">
                                    <h5 class="font-title-sm text-title-sm font-semibold text-on-surface flex items-center gap-xs">
                                        <span class="material-symbols-outlined text-primary text-sm">menu_book</span>
                                        @s.Name (@label)
                                    </h5>
                                    <div class="flex items-center gap-sm mt-xs text-on-surface-variant">
                                        <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">@s.Passages.Count passages</span>
                                        <span class="font-body-xs text-body-xs bg-surface-container p-1 rounded">@s.Questions.Count questions</span>
                                    </div>
                                </div>
                                <div class="flex shrink-0">
                                    <button type="button" onclick="confirmDelete('readingset', @s.QuestionGroupId, '@s.Name (@label)')" class="text-error hover:bg-error-container/20 p-2 rounded-lg transition-colors flex items-center justify-center">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="qc-empty-state">
                        <p class="font-body-md text-body-md text-on-surface-variant mb-md">No Part 7 reading sets yet.</p>
                    </div>
                }
                @if (canAddP7)
                {
                    <div class="flex justify-end">
                        <a href="/Admin/Exams/@exam.Id/Questions/Create/Part7" class="qc-btn-secondary">
                            <span class="material-symbols-outlined text-sm">add</span>
                            Add Reading Set
                        </a>
                    </div>
                }
                else
                {
                    <p class="font-body-sm text-body-sm text-on-surface-variant text-center py-2">Part 7 is complete (@targetP7/@targetP7 questions).</p>
                }
            </div>
        </details>
    </section>
</div>

