@model ExamStructureViewModel
    <!-- Structural Progress Indicator -->
    <section class="qc-form-card">
        <div class="qc-section__header" style="margin-bottom:0.75rem;padding-bottom:0.75rem">
            <span class="material-symbols-outlined">analytics</span>
            <div>
                <div class="qc-section__title">Exam Structure Progress</div>
                <div class="qc-section__hint">Track completion across all 7 TOEIC parts</div>
            </div>
            <span class="qc-part-badge qc-part-badge--primary ml-auto">
                @Model.TotalQuestions total
            </span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-7 gap-md">
            <!-- Part 1 -->
            <div class="qc-progress-card @(Model.Part1Count > 0 ? "qc-progress-card--active" : "") @(Model.Part1Count >= ExamStructureViewModel.TargetP1 ? "qc-progress-card--complete" : "")">
                <div class="flex justify-between items-center font-label-sm text-label-sm font-semibold">
                    <span class="text-on-surface">Part 1</span>
                    <span class="text-on-surface-variant">@Model.Part1Count/@ExamStructureViewModel.TargetP1</span>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-300 @(Model.Part1Count >= ExamStructureViewModel.TargetP1 ? "bg-tertiary" : Model.Part1Count > 0 ? "bg-primary" : "bg-outline-variant/40")" style="width: @(Math.Min(100, (Model.Part1Count * 100) / ExamStructureViewModel.TargetP1))%"></div>
                </div>
            </div>

            <!-- Part 2 -->
            <div class="qc-progress-card @(Model.Part2Count > 0 ? "qc-progress-card--active" : "") @(Model.Part2Count >= ExamStructureViewModel.TargetP2 ? "qc-progress-card--complete" : "")">
