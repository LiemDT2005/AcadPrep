@page
@model AcadPrep.WebUI.Pages.Admin.Exams.DetailModel
@{
    Layout = "_ModeratorLayout";
    ViewData["Title"] = "Exam Details - " + Model.Exam.Title;

    var structure = ExamStructureViewModel.From(Model.Exam, isReadOnly: true);

    var hero = new ExamPageHeroViewModel
    {
        Exam = Model.Exam,
        TotalQuestions = structure.TotalQuestions,
        IsReadOnly = true,
        BreadcrumbCurrent = "Exam Details",
        HeroIcon = "info"
    };
}

<link rel="stylesheet" href="~/css/admin-question-create.css" />

<div class="w-full flex flex-col gap-lg pb-12">
    <partial name="_ExamPageHero" model="hero" />
    <partial name="_ExamStatsPanel" model="structure" />
    <partial name="_ExamStructureProgress" model="structure" />
    <partial name="_ExamQuestionTree" model="structure" />

    @if (!Model.Exam.IsDeleted)
    {
        <div class="flex justify-end">
            <button type="button"
                    data-exam-id="@Model.Exam.Id"
                    data-exam-title="@Model.Exam.Title"
                    onclick="confirmSoftDelete(this.dataset.examId, this.dataset.examTitle)"
                    class="bg-error-container hover:bg-error-container/80 text-on-error-container font-label-md text-label-md py-2 px-4 rounded-lg flex items-center gap-xs transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-sm">visibility_off</span>
                Hide Exam
            </button>
        </div>
    }
</div>

@section Scripts {
<script>
    function confirmSoftDelete(id, title) {
        showConfirm({
            title: 'Hide Exam',
            message: `Are you sure you want to hide the exam "${title}"? Students will no longer be able to take it, but their past attempt history will remain intact.`,
            confirmText: 'Hide Exam',
            isDestructive: true,
            onConfirm: async () => {
                try {
                    const response = await fetch(`/api/Exams/${id}`, {
                        method: 'DELETE'
                    });

                    if (response.ok) {
                        showToast('Exam hidden successfully!', 'success');
                        setTimeout(() => {
                            window.location.href = '/Admin/Exams';
                        }, 1000);
                    } else {
                        const errorData = await response.json();
                        showToast(errorData.error || 'Failed to hide the exam.', 'error');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('Could not connect to the server.', 'error');
                }
            }
        });
    }
</script>
}
