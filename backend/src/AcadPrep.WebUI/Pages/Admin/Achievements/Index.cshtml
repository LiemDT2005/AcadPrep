@page
@model AcadPrep.WebUI.Pages.Admin.Achievements.IndexModel
@{
    ViewData["Title"] = "Manage Achievements";
    Layout = "_AdminLayout";
}

<div class="p-lg md:p-margin-desktop flex-1">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-tertiary-container text-on-tertiary-container p-sm rounded-lg mb-md">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-error-container text-on-error-container p-sm rounded-lg mb-md">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-xl flex flex-col md:flex-row md:items-center justify-between gap-md">
        <div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-xs">Achievement Badges</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Manage the gamification badges and unlock criteria for students.</p>
        </div>
        <a asp-page="./Create" class="bg-primary text-on-primary font-label-md text-label-md px-md py-sm rounded-lg flex items-center gap-xs hover:bg-primary-container transition-colors shadow-sm inline-flex">
            <span class="material-symbols-outlined text-[18px]">add_circle</span>
            Create New Badge
        </a>
    </div>

    <!-- Main Data Table Card -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant overflow-hidden">
        <!-- Table Header/Toolbar -->
        <div class="p-md border-b border-outline-variant bg-surface-container-low flex items-center justify-between">
            <div class="relative w-64">
                <span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
                <input class="w-full pl-xl pr-sm py-sm rounded-lg border border-outline-variant bg-surface-container-lowest text-body-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all" placeholder="Search achievements..." type="text">
            </div>
            <button class="text-on-surface-variant hover:text-on-surface flex items-center gap-xs font-label-md text-label-md">
                <span class="material-symbols-outlined text-[18px]">filter_list</span> Filter
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-bright border-b border-outline-variant">
                        <th class="p-md font-label-sm text-label-sm text-on-surface-variant font-semibold w-16 text-center">Icon</th>
                        <th class="p-md font-label-sm text-label-sm text-on-surface-variant font-semibold w-1/4">Name</th>
                        <th class="p-md font-label-sm text-label-sm text-on-surface-variant font-semibold hidden lg:table-cell w-1/3">Description</th>
                        <th class="p-md font-label-sm text-label-sm text-on-surface-variant font-semibold w-fit whitespace-nowrap">Unlock Condition</th>
                        <th class="p-md font-label-sm text-label-sm text-on-surface-variant font-semibold w-32 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant">
                    @if (!Model.Achievements.Any())
                    {
                        <tr>
                            <td colspan="5" class="p-xl text-center">
                                <span class="material-symbols-outlined text-[48px] text-surface-variant mb-md">military_tech</span>
                                <h5 class="font-headline-sm text-headline-sm text-on-surface mb-xs">No achievements found</h5>
                                <p class="font-body-sm text-body-sm text-on-surface-variant mb-md">Get started by creating a new badge to engage your users!</p>
                                <a asp-page="./Create" class="inline-flex bg-primary text-on-primary font-label-md text-label-md px-md py-sm rounded-lg hover:bg-primary-container transition-colors shadow-sm">
                                    Create First Badge
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var achievement in Model.Achievements)
                        {
                            <tr class="hover:bg-surface-container-low transition-colors group">
                                <td class="p-md text-center">
                                    <div class="w-10 h-10 rounded-full bg-secondary-fixed mx-auto flex items-center justify-center text-on-secondary-fixed overflow-hidden">
                                        @if (!string.IsNullOrEmpty(achievement.IconUrl))
                                        {
                                            <img src="@achievement.IconUrl" alt="@achievement.Name" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">emoji_events</span>
                                        }
                                    </div>
                                </td>
                                <td class="p-md">
                                    <div class="font-label-md text-label-md text-on-surface font-semibold">@achievement.Name</div>
                                    <div class="font-body-sm text-body-sm text-on-surface-variant lg:hidden line-clamp-1">@achievement.Description</div>
                                </td>
                                <td class="p-md hidden lg:table-cell max-w-[300px]">
                                    <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2">@achievement.Description</p>
                                </td>
                                <td class="p-md whitespace-nowrap">
                                    <div class="flex items-center gap-sm bg-surface-container-high px-md py-sm rounded-full w-fit border border-outline-variant whitespace-nowrap">
                                        <span class="material-symbols-outlined text-[18px] text-primary">military_tech</span>
                                        <div class="flex flex-col">
                                            <span class="text-label-sm font-bold text-on-surface-variant uppercase tracking-wider">@achievement.ConditionType</span>
                                            <span class="text-body-sm font-semibold text-on-surface">@achievement.ConditionValue Required</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="p-md text-right">
                                    <div class="flex items-center justify-end gap-sm transition-opacity">
                                        <a asp-page="./Edit" asp-route-id="@achievement.AchievementId" class="flex items-center gap-xs px-md py-sm rounded-lg bg-surface-variant text-on-surface-variant hover:bg-surface-container-high transition-colors font-label-sm" title="Edit">
                                            <span class="material-symbols-outlined text-[18px]">edit</span> Edit
                                        </a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@achievement.AchievementId" class="inline" onsubmit="return confirm('Are you sure you want to delete this achievement?');">
                                            <button type="submit" class="w-8 h-8 rounded-lg text-error hover:bg-error-container border border-transparent hover:border-error flex items-center justify-center transition-colors" title="Delete">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Footer -->
        <div class="p-md border-t border-outline-variant bg-surface-container-low flex items-center justify-between text-body-sm text-on-surface-variant">
            <div class="">Showing @Model.Achievements.Count Achievements</div>
            <div class="flex items-center gap-sm">
                <button class="w-8 h-8 rounded flex items-center justify-center hover:bg-surface-variant transition-colors disabled:opacity-50" disabled="">
                    <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </button>
                <button class="w-8 h-8 rounded bg-primary-fixed text-on-primary-fixed flex items-center justify-center font-label-sm">1</button>
                <button class="w-8 h-8 rounded flex items-center justify-center hover:bg-surface-variant transition-colors disabled:opacity-50" disabled="">
                    <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </button>
            </div>
        </div>
    </div>
</div>
