@page
@model AcadPrep.WebUI.Pages.Exams.TakeModel
@using System.Text.Json
@using System.Text.Json.Serialization
@{
    Layout = null;
    var session = Model.Session!;
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var questionsJson = JsonSerializer.Serialize(session.Questions, jsonOptions);
    var answersJson = JsonSerializer.Serialize(session.SavedAnswers, jsonOptions);
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Full Test — @session.ExamTitle | AcadPrep</title>
    <partial name="Shared/_ExamTestAssets" />
</head>
<body class="bg-surface font-body-md text-on-surface min-h-screen flex flex-col">

    <header class="sticky top-0 z-40 bg-surface-container-lowest border-b border-outline-variant/30 shadow-sm">
        <div class="mx-auto px-6 py-3">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                    <span class="shrink-0 px-2.5 py-1 rounded-lg bg-primary text-on-primary text-label-sm font-bold uppercase">Full Test</span>
                    <h1 class="font-headline-sm font-semibold truncate">@session.ExamTitle</h1>
                </div>
                <div class="flex items-center gap-4">
                    <span id="current-part-label" class="text-body-sm text-on-surface-variant">Part 1</span>
                    <span id="exam-timer" class="font-mono text-headline-sm font-bold tabular-nums text-primary">--:--:--</span>
                    <button id="btn-submit" type="button" class="bg-primary hover:bg-primary-container text-on-primary font-label-sm font-bold px-5 py-2.5 rounded-xl flex items-center gap-1">
                        <span class="material-symbols-outlined text-lg">send</span> Submit
                    </button>
                </div>
            </div>
            <div id="audio-locked-row" class="mt-2 flex items-center gap-2 hidden">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-error/10 text-error text-label-sm font-medium">
                    <span class="material-symbols-outlined text-sm">lock</span> AUDIO LOCKED
                </span>
            </div>
        </div>
    </header>

    <main class="flex-1 mx-auto w-full px-6 py-6 flex flex-col gap-6">
        <section id="audio-section" class="bg-surface-container-low rounded-2xl border border-outline-variant/30 p-4 hidden">
            <div class="flex items-center justify-between mb-2">
                <span class="text-body-sm font-medium text-on-surface-variant">Audio — plays once</span>
                <span id="audio-time" class="text-body-sm font-mono text-on-surface-variant"></span>
            </div>
            <audio id="exam-audio" class="w-full" preload="auto" controlsList="nodownload"></audio>
        </section>

        <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 p-6 min-h-[240px]">
                <div class="flex items-center justify-between mb-4">
                    <span id="question-label" class="text-label-sm font-bold text-primary">Question 1</span>
                </div>
                <div id="question-image-wrap" class="hidden mb-4">
                    <img id="question-image" alt="Question" class="max-h-64 rounded-xl mx-auto border border-outline-variant/30" />
                </div>
                <p id="question-text" class="text-body-md text-on-surface"></p>
            </div>
            <div id="options-container" class="space-y-3"></div>
        </section>

        <div class="flex items-center justify-between py-2 border-t border-outline-variant/20">
            <button id="btn-prev" type="button" class="flex items-center gap-1 px-4 py-2 rounded-xl text-on-surface-variant hover:bg-surface-container">
                <span class="material-symbols-outlined">arrow_back</span> Prev
            </button>
            <span class="text-body-sm font-medium">Question <span id="current-q-num">1</span> / <span id="total-q-num">@session.Questions.Count</span></span>
            <button id="btn-next" type="button" class="flex items-center gap-1 px-4 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high font-medium">
                Next <span class="material-symbols-outlined">arrow_forward</span>
            </button>
        </div>

        <section class="bg-surface-container-lowest rounded-2xl border border-outline-variant/30 p-4">
            <div class="flex justify-between items-center mb-3">
                <h2 class="font-headline-sm font-semibold">Question Navigator</h2>
                <span class="text-body-sm text-on-surface-variant"><span id="answered-count">@session.SavedAnswers.Count</span> / @session.Questions.Count</span>
            </div>
            <div id="question-palette" class="grid gap-1 overflow-x-auto" style="grid-template-columns: repeat(20, minmax(28px, 1fr));"></div>
        </section>
    </main>

    <footer class="border-t border-outline-variant/20 py-3 px-4 text-center">
        <button id="btn-exit" type="button" data-exit-url="/Exams/Detail/@session.ExamId" class="text-body-sm text-on-surface-variant hover:text-primary">← Exit test</button>
    </footer>

    <div id="modal-submit" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/40 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 space-y-4">
            <h3 class="font-headline-md font-bold">Confirm submission</h3>
            <p class="text-body-sm text-error">Once submitted, you cannot change your answers.</p>
            <div class="flex gap-3">
                <button data-close-submit type="button" class="flex-1 py-3 rounded-xl border font-medium">Continue</button>
                <button data-confirm-submit type="button" class="flex-1 py-3 rounded-xl bg-primary text-on-primary font-bold">Submit</button>
            </div>
        </div>
    </div>

    <div id="modal-leave" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/40 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 space-y-4">
            <h3 class="font-headline-md font-bold">Leave the test?</h3>
            <p class="text-body-sm text-on-surface-variant">Your progress and remaining time will be saved.</p>
            <div class="flex gap-3">
                <button data-close-leave type="button" class="flex-1 py-3 rounded-xl border font-medium">Continue</button>
                <button data-confirm-leave type="button" class="flex-1 py-3 rounded-xl bg-primary text-on-primary font-bold">Save & exit</button>
            </div>
        </div>
    </div>

    <div id="modal-timeout" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/60 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-2xl max-w-sm w-full p-8 text-center space-y-4">
            <h3 class="font-headline-md font-bold text-error">Time's up!</h3>
            <p class="text-body-md text-on-surface-variant">Grading your test…</p>
        </div>
    </div>

    <script>
        window.examSessionConfig = {
            mode: 'full',
            attemptId: @session.AttemptId,
            examId: @session.ExamId,
            examAudioUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(session.ExamAudioUrl)),
            remainingSeconds: @session.RemainingSeconds,
            questions: @Html.Raw(questionsJson),
            savedAnswers: @Html.Raw(answersJson),
            currentIndex: @session.CurrentQuestionIndex,
            apiBase: '?handler='
        };
    </script>
    <script src="~/js/exam-session.js"></script>
</body>
</html>
