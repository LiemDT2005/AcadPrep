@page
@model AcadPrep.WebUI.Pages.Exams.TakeModel
@using System.Text.Json
@{
    Layout = null;
    var session = Model.Session!;
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var questionsJson = JsonSerializer.Serialize(session.Questions, jsonOptions);
    var answersJson = JsonSerializer.Serialize(session.SavedAnswers, jsonOptions);
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Full Test — @session.ExamTitle | AcadPrep</title>
    <partial name="Shared/_ExamTestAssets" />
</head>
<body class="bg-surface font-body-md text-on-surface h-screen overflow-hidden flex flex-col">

    <header class="shrink-0 z-40 w-full bg-primary text-on-primary shadow-lg font-[Inter]">
        <div class="px-4 md:px-6 h-16 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
                <button id="btn-sidebar-toggle" type="button" class="shrink-0 w-10 h-10 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-opacity" title="Question list" aria-label="Toggle question list">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <a href="/Performance/Dashboard" class="hidden sm:flex items-center gap-1.5 text-white hover:opacity-90 shrink-0" style="text-decoration:none;">
                    <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' 1;">school</span>
                    <span class="text-[18px] font-extrabold tracking-tight">AcadPrep</span>
                </a>
                <span class="hidden sm:inline text-white/30">|</span>
                <span class="shrink-0 px-2.5 py-1 rounded-md bg-white/15 text-white text-label-sm font-bold uppercase tracking-wide">Full Test</span>
                <h1 class="font-headline-sm font-semibold truncate text-white/95">@session.ExamTitle</h1>
            </div>
            <div class="flex items-center gap-3">
                <span id="current-part-label" class="text-label-md text-white/80 hidden sm:inline">Part 1</span>
                <span id="exam-timer" class="font-mono text-lg font-bold tabular-nums bg-white text-primary px-3 py-1.5 rounded-lg shadow-sm">--:--:--</span>
                <button id="btn-submit" type="button" class="bg-white text-primary hover:bg-white/90 font-label-md font-bold px-5 py-2.5 rounded-lg flex items-center gap-1 shadow-sm transition-all">
                    <span class="material-symbols-outlined text-lg">send</span> Submit
                </button>
            </div>
        </div>
        <div id="audio-locked-row" class="px-4 md:px-6 pb-2.5 hidden">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-error/20 text-red-100 text-label-sm font-medium">
                <span class="material-symbols-outlined text-sm">lock</span> AUDIO LOCKED — listening once only
            </span>
        </div>
    </header>

    <div class="flex-1 flex min-h-0 relative">
        <!-- Question sidebar (Zenlish-style drawer) -->
        <aside id="question-sidebar" class="exam-sidebar absolute inset-y-0 left-0 z-30 w-[300px] max-w-[90vw] bg-white border-r border-outline-variant/40 shadow-2xl flex flex-col -translate-x-full transition-transform duration-200">
            <div class="shrink-0 px-4 py-3 border-b border-outline-variant/30 flex items-center justify-between">
                <div>
                    <h2 class="font-headline-sm font-semibold">Questions</h2>
                    <p class="text-body-sm text-on-surface-variant"><span id="answered-count">@session.SavedAnswers.Count</span> / @session.Questions.Count answered</p>
                </div>
                <button id="btn-sidebar-close" type="button" class="w-8 h-8 rounded-lg hover:bg-surface-container flex items-center justify-center">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div id="question-palette" class="flex-1 overflow-y-auto p-3 space-y-4"></div>
        </aside>
        <div id="sidebar-backdrop" class="exam-sidebar-backdrop absolute inset-0 z-20 bg-black/30 hidden"></div>

        <!-- Main workspace -->
        <main class="flex-1 min-w-0 min-h-0 overflow-y-auto relative">
            <!-- Section intro overlays (full test) -->
            <div id="section-intro" class="hidden absolute inset-0 z-20 bg-surface flex items-center justify-center p-6">
                <div class="max-w-lg w-full bg-surface-container-lowest rounded-2xl border border-outline-variant/30 shadow-lg p-8 text-center space-y-6">
                    <div class="mx-auto w-16 h-16 rounded-2xl bg-primary/10 text-primary flex items-center justify-center">
                        <span id="section-intro-icon" class="material-symbols-outlined text-4xl">headphones</span>
                    </div>
                    <div class="space-y-2">
                        <p id="section-intro-eyebrow" class="text-label-sm font-bold uppercase tracking-wider text-primary">Section</p>
                        <h2 id="section-intro-title" class="font-headline-md font-bold text-2xl">Listening Test</h2>
                        <p id="section-intro-desc" class="text-body-md text-on-surface-variant">Parts 1–4 · 45 minutes</p>
                    </div>
                    <ul id="section-intro-rules" class="text-left text-body-sm text-on-surface-variant space-y-2 bg-surface-container-low rounded-xl p-4"></ul>
                    <button id="btn-section-start" type="button" class="w-full py-3.5 rounded-xl bg-primary text-on-primary font-bold text-body-md hover:bg-primary-container">
                        Start
                    </button>
                </div>
            </div>

            <div id="exam-workspace" class="h-full flex flex-col p-4 md:p-6 gap-4">
                <div class="flex items-center justify-between shrink-0">
                    <span id="question-label" class="text-label-sm font-bold text-primary">Question 1</span>
                    <span class="px-3 py-1 rounded-md bg-primary text-on-primary text-label-sm font-bold tabular-nums">
                        <span id="answered-count-badge">@session.SavedAnswers.Count</span>/<span id="total-q-num">@session.Questions.Count</span>
                    </span>
                </div>

                <section id="audio-section" class="shrink-0 bg-surface-container-low rounded-xl border border-outline-variant/30 p-3 hidden">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-body-sm font-medium text-on-surface-variant">Audio — plays once</span>
                        <span id="audio-time" class="text-body-sm font-mono text-on-surface-variant"></span>
                    </div>
                    <audio id="exam-audio" class="w-full" preload="auto" controlsList="nodownload"></audio>
                </section>

                <section class="flex-1 min-h-0 grid grid-cols-1 lg:grid-cols-2 gap-0 lg:gap-0 rounded-xl border border-outline-variant/30 overflow-hidden bg-surface-container-lowest">
                    <div class="p-5 md:p-6 min-h-[200px] overflow-y-auto border-b lg:border-b-0 lg:border-r-4 lg:border-r-primary/40">
                        <div id="question-image-wrap" class="hidden mb-4">
                            <img id="question-image" alt="Question" class="max-h-80 rounded-lg mx-auto border border-outline-variant/30" />
                        </div>
                        <div id="question-text" class="text-body-md text-on-surface whitespace-pre-wrap"></div>
                    </div>
                    <div id="options-container" class="p-5 md:p-6 space-y-3 overflow-y-auto bg-surface-container-lowest"></div>
                </section>

                <p id="nav-hint" class="text-center text-body-sm text-on-surface-variant shrink-0">
                    Listening advances when audio ends. Parts 3–4 show 3 questions per set.
                </p>

                <div id="reading-nav" class="hidden flex items-center justify-between shrink-0 py-1">
                    <button id="btn-prev" type="button" class="flex items-center gap-1 px-4 py-2.5 rounded-xl border border-outline-variant/40 hover:bg-surface-container font-medium">
                        <span class="material-symbols-outlined">arrow_back</span> Prev
                    </button>
                    <span class="text-body-sm font-medium">Q <span id="current-q-num">1</span> / <span id="total-q-num-nav">@session.Questions.Count</span></span>
                    <button id="btn-next" type="button" class="flex items-center gap-1 px-4 py-2.5 rounded-xl bg-primary text-on-primary font-medium hover:bg-primary-container">
                        Next <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </div>
            </div>
        </main>
    </div>

    <footer class="shrink-0 border-t border-outline-variant/20 py-2 px-4 text-center bg-surface-container-lowest">
        <button id="btn-exit" type="button" data-exit-url="/Exams/Detail/@session.ExamId" class="text-body-sm text-on-surface-variant hover:text-primary">← Exit test</button>
    </footer>

    <div id="modal-submit" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/40 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 space-y-4">
            <h3 class="font-headline-md font-bold">Confirm submission</h3>
            <p class="text-body-sm text-error">Once submitted, you cannot change your answers.</p>
            <div class="flex gap-3">
                <button data-close-submit type="button" class="flex-1 py-3 rounded-xl border font-medium">Continue</button>
                <button data-confirm-submit type="button" class="flex-1 py-3 rounded-xl bg-primary text-on-primary font-bold">Submit</button>
            </div>
        </div>
    </div>

    <div id="modal-leave" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/40 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 space-y-4">
            <h3 class="font-headline-md font-bold">Leave the test?</h3>
            <p class="text-body-sm text-on-surface-variant">Your progress and remaining time will be saved.</p>
            <div class="flex gap-3">
                <button data-close-leave type="button" class="flex-1 py-3 rounded-xl border font-medium">Continue</button>
                <button data-confirm-leave type="button" class="flex-1 py-3 rounded-xl bg-primary text-on-primary font-bold">Save & exit</button>
            </div>
        </div>
    </div>

    <div id="modal-timeout" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/60 backdrop-blur-sm">
        <div class="bg-surface-container-lowest rounded-2xl max-w-sm w-full p-8 text-center space-y-4">
            <h3 class="font-headline-md font-bold text-error">Time's up!</h3>
            <p id="timeout-message" class="text-body-md text-on-surface-variant">Grading your test…</p>
        </div>
    </div>

    <script>
        window.examSessionConfig = {
            mode: 'full',
            attemptId: @session.AttemptId,
            examId: @session.ExamId,
            examAudioUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(session.ExamAudioUrl)),
            remainingSeconds: @session.RemainingSeconds,
            questions: @Html.Raw(questionsJson),
            savedAnswers: @Html.Raw(answersJson),
            currentIndex: @session.CurrentQuestionIndex,
            apiBase: '?handler=',
            listeningSeconds: 45 * 60,
            readingSeconds: 75 * 60
        };
    </script>
    <script src="~/js/exam-session.js"></script>
</body>
</html>
