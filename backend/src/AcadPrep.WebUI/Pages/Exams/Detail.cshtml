                            <div class="w-full h-2 bg-surface-container-high rounded-full overflow-hidden">
                                <div class="h-full bg-primary" style="width: 65%;"></div>
                            </div>
                            <div class="mt-xl flex -space-x-2">
                                <img class="w-8 h-8 rounded-full border-2 border-surface" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDtEHpXgV-zo_a-we1OrWe8pHhV0E_jxoGF0SmCe6sRH_5eTyXkBNFlvLSfHde9RfXAGAYsC26ASD1sRs__EDOwZ6a_T4RETizJK7YFc2mmFOUN6oDByaJ32i2cdeyd7WpeFNnZK6Kzt0XcVa6LEwkeQPXZCq9KAgFsVglhsFvICFNk5LMwPhxllXvtG6OnwxbQJw7ozoxCYjd1c81c1PL9G9UFsmxSZT2FVcNwccKMFzGYruxYUzzuXhsRGZIdtrwoV3IFpIxPfHzN" alt="User 1">
