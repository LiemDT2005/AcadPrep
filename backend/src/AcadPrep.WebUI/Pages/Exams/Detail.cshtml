@page "{id:int}"
@model AcadPrep.WebUI.Pages.Exams.DetailModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@Model.ExamDetail?.Title | AcadPrep</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #c7c4d8; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #777587; }
        .glass-card { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); }
        .custom-shadow { box-shadow: 0 4px 20px -2px rgba(30, 0, 169, 0.05); }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-container-highest": "#e4e1ee",
                        "primary-container": "#3525cd",
                        "outline-variant": "#c7c4d8",
                        "on-surface-variant": "#464555",
                        "tertiary-container": "#005338",
                        "surface-container-high": "#eae6f4",
                        "surface": "#f9f9ff",
                        "primary": "#1e00a9",
                        "outline": "#777587",
                        "inverse-primary": "#c3c0ff",
                        "on-tertiary-fixed": "#002114",
                        "on-secondary-fixed": "#341100",
                        "secondary-container": "#ff8d4b",
                        "on-tertiary-fixed-variant": "#005237",
                        "on-secondary": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "secondary-fixed": "#ffdbca",
                        "primary-fixed-dim": "#c3c0ff",
                        "on-surface": "#1b1b24",
                        "on-secondary-container": "#6c2c00",
                        "error-container": "#ffdad6",
                        "on-primary-fixed": "#0f0069",
                        "on-error": "#ffffff",
                        "primary-fixed": "#e2dfff",
                        "surface-dim": "#dcd8e5",
                        "on-secondary-fixed-variant": "#783200",
                        "surface-bright": "#fcf8ff",
                        "surface-tint": "#4d44e3",
                        "inverse-on-surface": "#f3effc",
                        "tertiary-fixed-dim": "#8fd5b2",
                        "on-primary-fixed-variant": "#3323cc",
                        "background": "#fcf8ff",
                        "surface-container": "#f0ecf9",
                        "inverse-surface": "#302f39",
                        "tertiary": "#005338",
                        "on-primary": "#ffffff",
                        "on-background": "#1b1b24",
                        "secondary": "#9d4300",
                        "on-primary-container": "#b1afff",
                        "tertiary-fixed": "#abf2cd",
                        "secondary-fixed-dim": "#ffb690",
                        "surface-container-low": "#f5f2ff",
                        "error": "#ba1a1a",
                        "on-tertiary-container": "#80c5a3",
                        "on-tertiary": "#ffffff",
                        "surface-variant": "#e4e1ee",
                        "on-error-container": "#93000a"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "2xl": "16px",
                        "full": "9999px"
                    },
                    "spacing": {
                        "base_unit": "4px",
                        "unit": "4px",
                        "md": "16px",
                        "margin-desktop": "40px",
                        "lg": "24px",
                        "margin-mobile": "16px",
                        "xs": "4px",
                        "3xl": "64px",
                        "2xl": "48px",
                        "sm": "8px",
                        "gutter": "24px",
                        "xl": "32px"
                    },
                    "fontFamily": {
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "body-sm": ["Inter"],
                        "label-md": ["Inter"],
                        "headline-lg": ["Inter"],
                        "display-lg": ["Inter"],
                        "headline-md": ["Inter"],
                        "label-sm": ["Inter"],
                        "headline-sm": ["Inter"]
                    },
                }
            }
        }
    </script>
</head>
<body class="bg-surface font-body-md text-on-surface">

    <!-- Top Navigation Bar Header matching index page aesthetic -->
    <header class="border-b border-outline-variant/30 bg-surface-container-lowest sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-margin-desktop py-md flex items-center justify-between">
            <div class="flex items-center gap-lg">
                <a href="/Exams" class="font-display-lg text-primary text-headline-sm flex items-center gap-xs font-bold tracking-tight">
                    <span>📚 AcadPrep</span>
                </a>
                <nav class="hidden md:flex items-center gap-md text-label-md font-bold text-on-surface-variant">
                    <a href="/Courses" class="hover:text-primary transition-colors">Courses</a>
                    <a href="/Exams" class="text-primary">Exams</a>
                </nav>
            </div>
            <div class="flex items-center gap-md">
                @if (Model.IsLoggedIn)
                {
                    <div class="flex items-center gap-sm">
                        <img class="w-8 h-8 rounded-full border border-outline-variant" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAoDUOYz2KcAQ4v01N98CsRrUic8DFOS96b1C0LozaXb0m-hfkSjv_PChiEfB1z16EMwZAmb3rVKB5UxDzlVo1VgL6Emdy_WmRiZEKrMlu_iXXSIik8-U8f22K9lxddCM1BJAXjgxaziav2Tu-x8zHPFfnkjRrSVT1kLz7TRfHmP2GYG1oWHhWJfEogEZqHvgpq6Gp-My9W4ibuHu12xr2iPFzftZm-SzjGLFaqtOmKB0TeK9xwn_eVsUZFTXq4qyM3SRQTsrliR4MU" alt="Profile">
                        <span class="text-label-md font-bold text-on-surface hidden sm:inline">Minh Tran</span>
                    </div>
                }
                else
                {
                    <a href="#" class="text-label-md font-bold text-primary hover:underline">Login</a>
                    <a href="#" class="bg-primary text-on-primary px-4 py-2 rounded-xl text-label-md font-bold hover:bg-primary-container transition-all">Sign Up</a>
                }
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-margin-desktop py-xl">
        <!-- Breadcrumb Navigation -->
        <nav class="flex items-center gap-xs text-on-surface-variant mb-lg">
            <a href="/Exams" class="text-label-sm font-label-sm uppercase tracking-wider hover:text-primary transition-colors">Exam Library</a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <span class="text-label-sm font-label-sm text-primary uppercase tracking-wider">@Model.ExamDetail?.Title</span>
        </nav>

        @if (Model.ExamDetail == null)
        {
            <div class="bg-error-container text-on-error-container p-lg rounded-2xl flex items-center gap-md">
                <span class="material-symbols-outlined text-[24px]">error</span>
                <span class="text-body-md font-label-md">Failed to load exam details. Please go back and try again.</span>
            </div>
        }
        else
        {
            <!-- Hero Section -->
            <section class="mb-xl bg-surface-container-lowest rounded-2xl p-xl shadow-sm border border-outline-variant/20">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-lg">
                    <div>
                        <div class="flex flex-wrap gap-2 mb-sm">
                            <span class="bg-primary-container/10 text-primary-container px-3 py-1 rounded-full text-label-sm font-bold uppercase tracking-wider">TOEIC</span>
                            <span class="bg-surface-container-highest text-on-surface-variant px-3 py-1 rounded-full text-label-sm font-bold">@Model.ExamDetail.SeriesName</span>
                            <span class="bg-tertiary-container/10 text-tertiary-fixed-dim px-3 py-1 rounded-full text-label-sm font-bold">Year @Model.ExamDetail.Year</span>
                        </div>
                        <h1 class="font-headline-lg text-headline-lg text-on-surface mb-xs">@Model.ExamDetail.Title</h1>
                    </div>
                    <div class="flex gap-4 items-center">
                        <div class="text-right">
                            <p class="text-label-sm text-on-surface-variant">Last updated</p>
                            <p class="font-label-md font-bold text-on-surface">Oct 2024</p>
                        </div>
                        <div class="w-12 h-12 rounded-xl bg-primary/5 flex items-center justify-center">
                            <span class="material-symbols-outlined text-primary">event_available</span>
                        </div>
                    </div>
                </div>
                
                <!-- Stats Bar -->
                <div class="grid grid-cols-2 md:grid-cols-6 gap-lg mt-xl pt-xl border-t border-outline-variant/30">
                    <div class="flex flex-col">
                        <span class="text-on-surface-variant text-label-sm mb-1 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">schedule</span> @Model.ExamDetail.Duration mins
                        </span>
                        <span class="font-headline-sm text-headline-sm font-bold text-on-surface">Duration</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-on-surface-variant text-label-sm mb-1 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">quiz</span> @Model.ExamDetail.TotalQuestions questions
                        </span>
                        <span class="font-headline-sm text-headline-sm font-bold text-on-surface">Questions</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-on-surface-variant text-label-sm mb-1 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">layers</span> @Model.ExamDetail.Parts.Count parts
                        </span>
                        <span class="font-headline-sm text-headline-sm font-bold text-on-surface">Structure</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-on-surface-variant text-label-sm mb-1 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">trending_up</span> @(Model.ExamDetail.TotalAttempts >= 1000 ? $"{(Model.ExamDetail.TotalAttempts / 1000.0):F1}k" : Model.ExamDetail.TotalAttempts.ToString()) Attempts
                        </span>
                        <span class="font-headline-sm text-headline-sm font-bold text-on-surface">Popularity</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-on-surface-variant text-label-sm mb-1 flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm text-secondary">star</span> 4.8 Rating
                        </span>
                        <span class="font-headline-sm text-headline-sm font-bold text-on-surface">Feedback</span>
                    </div>
                    <div class="flex flex-col items-end">
                        <button class="bg-surface-container-high hover:bg-surface-container-highest text-primary p-2 rounded-lg transition-colors">
                            <span class="material-symbols-outlined">share</span>
                        </button>
                    </div>
                </div>
            </section>

            <div class="flex flex-col lg:flex-row gap-lg">
                <!-- Left Main Area: Tabs & Cards -->
                <div class="w-full lg:w-2/3">
                    <!-- Tab Headers -->
                    <div class="flex border-b border-outline-variant/30 mb-lg">
                        <button class="px-xl py-md text-primary font-bold border-b-2 border-primary transition-all flex items-center gap-2" id="tab-practice" onclick="switchTab('practice')">
                            <span class="material-symbols-outlined">fitness_center</span> Practice Mode
                        </button>
                        <button class="px-xl py-md text-on-surface-variant hover:text-on-surface transition-all flex items-center gap-2" id="tab-fulltest" onclick="switchTab('fulltest')">
                            <span class="material-symbols-outlined">timer</span> Full Test
                        </button>
                        <button class="px-xl py-md text-on-surface-variant hover:text-on-surface transition-all flex items-center gap-2" id="tab-info" onclick="switchTab('info')">
                            <span class="material-symbols-outlined">info</span> Info
                        </button>
                    </div>                    <!-- Tab Content: Practice (Active) -->
                    <div class="space-y-md" id="content-practice">
                        <!-- Part Selection Cards -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                            @foreach (var part in Model.ExamDetail.Parts)
                            {
                                var partIcon = part.PartNumber switch
                                {
                                    1 => "photo_camera",
                                    2 => "question_answer",
                                    3 => "forum",
                                    4 => "volume_up",
                                    5 => "text_fields",
                                    6 => "edit_document",
                                    7 => "auto_stories",
                                    _ => "quiz"
                                };
                                
                                var partDifficulty = part.PartNumber switch
                                {
                                    1 => "Easy",
                                    2 => "Intermediate",
                                    3 => "Intermediate",
                                    4 => "Hard",
                                    5 => "Hard",
                                    6 => "Intermediate",
                                    7 => "Hard",
                                    _ => "Intermediate"
                                };

                                var difficultyColorClass = partDifficulty switch
                                {
                                    "Easy" => "text-on-tertiary-fixed-variant",
                                    "Intermediate" => "text-on-secondary-fixed-variant",
                                    "Hard" => "text-error",
                                    _ => "text-on-surface-variant"
                                };

                                var partTime = part.PartNumber switch
                                {
                                    1 => "10 mins",
                                    2 => "15 mins",
                                    3 => "20 mins",
                                    4 => "15 mins",
                                    5 => "10 mins",
                                    6 => "10 mins",
                                    7 => "55 mins",
                                    _ => "15 mins"
                                };
                                
                                var description = part.PartNumber switch
                                {
                                    1 => "Listen and select the best description for the image.",
                                    2 => "Choose the logical response to questions and statements.",
                                    3 => "Listen to short conversations and answer comprehension questions.",
                                    4 => "Listen to short talks/announcements and answer comprehension questions.",
                                    5 => "Fill in the blanks with appropriate grammar or vocabulary.",
                                    6 => "Complete the sentences in short texts/articles.",
                                    7 => "Read various texts and answer comprehension questions.",
                                    _ => "Answer questions for this section."
                                };

                                var partTags = part.PartNumber switch
                                {
                                     1 => new List<string> { "[Part 1] Tranh tả người", "[Part 1] Tranh tả cả người và vật" },
                                     2 => new List<string> { "[Part 2] Câu hỏi WHAT", "[Part 2] Câu hỏi WHO", "[Part 2] Câu hỏi WHERE", "[Part 2] Câu hỏi WHEN", "[Part 2] Câu hỏi HOW", "[Part 2] Câu hỏi WHY", "[Part 2] Câu hỏi YES/NO", "[Part 2] Câu hỏi đuôi", "[Part 2] Câu hỏi lựa chọn", "[Part 2] Câu yêu cầu, đề nghị", "[Part 2] Câu trần thuật" },
                                     3 => new List<string> { "[Part 3] Câu hỏi về chủ đề, mục đích", "[Part 3] Câu hỏi về danh tính người nói", "[Part 3] Câu hỏi về chi tiết cuộc hội thoại", "[Part 3] Câu hỏi về hành động tương lai", "[Part 3] Câu hỏi kết hợp bảng biểu", "[Part 3] Câu hỏi về hàm ý câu nói", "[Part 3] Chủ đề: Company - General Office Work", "[Part 3] Chủ đề: Company - Personnel", "[Part 3] Chủ đề: Company - Event, Project", "[Part 3] Chủ đề: Company - Facility", "[Part 3] Chủ đề: Shopping, Service", "[Part 3] Chủ đề: Housing", "[Part 3] Câu hỏi về yêu cầu, gợi ý" },
                                     4 => new List<string> { "[Part 4] Câu hỏi về chủ đề, mục đích", "[Part 4] Câu hỏi về danh tính, địa điểm", "[Part 4] Câu hỏi về chi tiết", "[Part 4] Câu hỏi về hành động tương lai", "[Part 4] Câu hỏi kết hợp bảng biểu", "[Part 4] Câu hỏi về hàm ý câu nói", "[Part 4] Dạng bài: Telephone message - Tin nhắn thoại", "[Part 4] Dạng bài: Announcement - Thông báo", "[Part 4] Dạng bài: News report, Broadcast - Bản tin", "[Part 4] Dạng bài: Talk - Bài phát biểu, diễn văn", "[Part 4] Câu hỏi yêu cầu, gợi ý" },
                                     5 => new List<string> { "[Part 5] Câu hỏi từ loại", "[Part 5] Câu hỏi ngữ pháp", "[Part 5] Câu hỏi từ vựng", "[Grammar] Danh từ", "[Grammar] Đại từ", "[Grammar] Tính từ", "[Grammar] Thì", "[Grammar] Thể", "[Grammar] Trạng từ", "[Grammar] Động từ nguyên mẫu có to", "[Grammar] Phân từ và Cấu trúc phân từ", "[Grammar] Giới từ", "[Grammar] Liên từ", "[Grammar] Cấu trúc so sánh" },
                                     6 => new List<string> { "[Part 6] Câu hỏi ngữ pháp", "[Part 6] Câu hỏi từ vựng", "[Part 6] Câu hỏi điền câu vào đoạn văn", "[Part 6] Hình thức: Thư điện tử/ thư tay (Email/ Letter)", "[Part 6] Hình thức: Quảng cáo (Advertisement)", "[Part 6] Hình thức: Thông báo/ văn bản hướng dẫn (Notice/ Announcement Information)", "[Part 6] Hình thức: Thông báo nội bộ (Memo)", "[Grammar] Danh từ", "[Grammar] Tính từ", "[Grammar] Thì", "[Grammar] Thể", "[Grammar] Phân từ và Cấu trúc phân từ", "[Grammar] Giới từ" },
                                     7 => new List<string> { "[Part 7] Câu hỏi tìm thông tin", "[Part 7] Câu hỏi tìm chi tiết sai", "[Part 7] Câu hỏi về chủ đề, mục đích", "[Part 7] Câu hỏi về suy luận", "[Part 7] Câu hỏi điền câu", "[Part 7] Cấu trúc: một đoạn", "[Part 7] Cấu trúc: nhiều đoạn", "[Part 7] Dạng bài: Email/ Letter: Thư điện tử/ Thư tay", "[Part 7] Dạng bài: Form - Đơn từ, biểu mẫu" },
                                     _ => new List<string>()
                                 };
                                
                                <div class="p-md bg-surface-container-lowest rounded-2xl border border-outline-variant/30 transition-all flex flex-col gap-sm relative">
                                    <div class="flex items-start gap-md cursor-pointer select-none" onclick="togglePartCheckbox(@part.PartNumber)">
                                        <input type="checkbox" id="part-check-@part.PartNumber" data-part="@part.PartNumber" class="part-checkbox form-checkbox text-primary focus:ring-primary w-5 h-5 rounded border-outline-variant mt-1" onclick="event.stopPropagation(); togglePartCheckbox(@part.PartNumber, true)">
                                        
                                        <div class="flex-grow">
                                            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-xs flex items-center gap-xs">
                                                <span class="material-symbols-outlined text-primary">@partIcon</span>
                                                @part.PartName
                                            </h3>
                                            <div class="flex gap-2 mb-xs flex-wrap">
                                                <span class="text-label-sm bg-surface-container px-2 py-0.5 rounded text-on-surface-variant font-bold">@part.QuestionCount Questions</span>
                                                <span class="text-label-sm bg-surface-container px-2 py-0.5 rounded text-on-surface-variant">@partTime</span>
                                            </div>
                                            <p class="text-body-sm text-on-surface-variant mb-xs">@description</p>
                                            <div class="flex items-center gap-1 text-label-sm @difficultyColorClass">
                                                <span class="material-symbols-outlined text-xs">signal_cellular_alt</span>
                                                @partDifficulty
                                            </div>
                                        </div>
                                    </div>
                                    
                                    @if (partTags.Any())
                                    {
                                        <div class="mt-xs pt-sm border-t border-outline-variant/20 flex flex-wrap gap-xs" onclick="event.stopPropagation();">
                                            @foreach (var tag in partTags)
                                            {
                                                <span class="inline-flex items-center bg-surface-container px-sm py-xs rounded-lg text-body-sm text-on-surface border border-outline-variant/30 select-none">
                                                    #@tag
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Time Limit Dropdown -->
                        <div class="bg-surface-container-low p-lg rounded-2xl flex flex-col md:flex-row items-center justify-between gap-md border border-outline-variant/20">
                            <div class="flex items-center gap-md">
                                <span class="material-symbols-outlined text-primary-container text-[28px]">timer</span>
                                <div>
                                    <h4 class="font-label-md font-bold text-on-surface">Giới Hạn Thời Gian</h4>
                                    <p class="text-body-sm text-on-surface-variant">Bài thi luyện tập sẽ kết thúc khi hết thời gian giới hạn.</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <select id="customTimeLimit" class="bg-surface-container-lowest border border-outline-variant rounded-lg py-2 pl-3 pr-10 focus:ring-2 focus:ring-primary focus:border-primary">
                                    <option value="">Không giới hạn</option>
                                    <option value="15">15 phút</option>
                                    <option value="30">30 phút</option>
                                    <option value="45">45 phút</option>
                                    <option value="60">60 phút</option>
                                    <option value="90">90 phút</option>
                                    <option value="120">120 phút</option>
                                </select>
                            </div>
                        </div>

                        <!-- Start Practice Button & Selection Status -->
                        <div class="sticky bottom-4 md:static flex flex-col gap-sm">
                            <div class="text-body-sm text-on-surface-variant text-center md:text-left font-medium" id="selection-summary">
                                7 Parts Selected | 7 Questions | ~10 mins
                            </div>
                            <button onclick="startPracticeSession()" class="w-full bg-secondary hover:bg-on-secondary-fixed-variant text-on-secondary font-headline-sm py-4 rounded-2xl shadow-lg shadow-secondary/20 transition-all active:scale-[0.98] flex items-center justify-center gap-2">
                                LUYỆN TẬP
                                <span class="material-symbols-outlined">play_arrow</span>
                            </button>
                        </div>
                    </div>

                    <!-- Tab Content: Full Test (Hidden) -->
                    <div class="hidden space-y-md animate-in fade-in duration-300" id="content-fulltest">
                        <div class="bg-primary/5 rounded-2xl p-xl border border-primary/10">
                            <div class="flex items-center gap-xl mb-xl">
                                <div class="w-16 h-16 rounded-full bg-primary flex items-center justify-center text-on-primary">
                                    <span class="material-symbols-outlined text-3xl">psychology</span>
                                </div>
                                <div>
                                    <h3 class="font-headline-md text-headline-md text-primary">Full Test Simulation</h3>
                                    <p class="text-body-md text-on-surface-variant">Attempt the official 2-hour TOEIC exam sequence under exam conditions.</p>
                                </div>
                            </div>
                            <ul class="space-y-md mb-xl">
                                <li class="flex items-center gap-4 text-on-surface">
                                    <span class="material-symbols-outlined text-tertiary">check_circle</span>
                                    <span>200 Questions (100 Listening / 100 Reading)</span>
                                </li>
                                <li class="flex items-center gap-4 text-on-surface">
                                    <span class="material-symbols-outlined text-tertiary">check_circle</span>
                                    <span>120 Minutes strict countdown timer</span>
                                </li>
                                <li class="flex items-center gap-4 text-on-surface">
                                    <span class="material-symbols-outlined text-tertiary">check_circle</span>
