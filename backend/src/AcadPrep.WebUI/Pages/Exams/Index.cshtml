@page
@model AcadPrep.WebUI.Pages.Exams.IndexModel
@{
    Layout = "_ModeratorLayout";
    ViewData["Title"] = "Exam Management";
    
    var totalExams = Model.Exams.Count;
    var activeExams = Model.Exams.Count(e => !e.IsDeleted);
    var hiddenExams = Model.Exams.Count(e => e.IsDeleted);
    var totalAttempts = Model.Exams.Sum(e => e.AttemptCount);
}

<div class="w-full flex flex-col gap-xl">
    
    <!-- 1. STATS ROW (Bento Grid Style) -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md">
        <div class="bg-surface-container-lowest rounded-xl p-md border border-outline-variant/30 shadow-sm relative overflow-hidden group">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-primary-fixed rounded-full opacity-20 group-hover:scale-110 transition-transform duration-500"></div>
            <div class="flex justify-between items-start mb-sm relative z-10">
                <span class="font-label-md text-label-md text-on-surface-variant">Total Exams</span>
                <span class="material-symbols-outlined text-primary">quiz</span>
            </div>
            <div class="flex items-end gap-sm relative z-10">
                <span class="font-display-lg text-display-lg text-on-surface">@totalExams</span>
                <span class="font-label-sm text-label-sm text-tertiary pb-2">Stored</span>
            </div>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-md border border-outline-variant/30 shadow-sm relative overflow-hidden group">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-primary-fixed rounded-full opacity-20 group-hover:scale-110 transition-transform duration-500"></div>
            <div class="flex justify-between items-start mb-sm relative z-10">
                <span class="font-label-md text-label-md text-on-surface-variant">Public Exams</span>
                <span class="material-symbols-outlined text-tertiary-container">check_circle</span>
            </div>
            <div class="flex items-end gap-sm relative z-10">
                <span class="font-display-lg text-display-lg text-on-surface">@activeExams</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant pb-2">Active / Published</span>
            </div>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-md border border-outline-variant/30 shadow-sm relative overflow-hidden group">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-primary-fixed rounded-full opacity-20 group-hover:scale-110 transition-transform duration-500"></div>
            <div class="flex justify-between items-start mb-sm relative z-10">
                <span class="font-label-md text-label-md text-on-surface-variant">Total Attempts</span>
                <span class="material-symbols-outlined text-primary">trending_up</span>
            </div>
            <div class="flex items-end gap-sm relative z-10">
                <span class="font-display-lg text-display-lg text-on-surface">@totalAttempts</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant pb-2">Attempts taken</span>
            </div>
        </div>
        <div class="bg-secondary-fixed rounded-xl p-md border border-secondary-fixed-dim shadow-sm relative overflow-hidden group">
            <div class="absolute top-0 right-0 -mr-4 -mt-4 w-24 h-24 bg-secondary-container rounded-full opacity-20 group-hover:scale-110 transition-transform duration-500"></div>
            <div class="flex justify-between items-start mb-sm relative z-10">
                <span class="font-label-md text-label-md text-on-secondary-fixed-variant">Hidden Exams</span>
                <span class="material-symbols-outlined text-secondary">visibility_off</span>
            </div>
            <div class="flex items-end gap-sm relative z-10">
                <span class="font-display-lg text-display-lg text-on-secondary-fixed">@hiddenExams</span>
                <span class="font-label-sm text-label-sm text-secondary pb-2">Hidden / Deleted</span>
            </div>
        </div>
    </section>

    <!-- 2. QUICK ACTIONS -->
    <section class="flex justify-between items-center gap-sm">
        <div class="flex gap-sm">
            <a href="/Exams/Create" class="bg-primary hover:bg-primary/90 text-on-primary font-label-md text-label-md py-2 px-4 rounded-lg flex items-center gap-xs transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-sm">add</span>
                Create New Exam
            </a>
        </div>
    </section>

    <!-- 3. EXAMS TABLE -->
    <section class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border border-outline-variant/30">
        <div class="px-md py-sm border-b border-outline-variant/50 flex justify-between items-center bg-surface-container/30">
            <h2 class="font-headline-md text-headline-md text-on-surface font-semibold">All Exams</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-lowest border-b border-outline-variant">
                        <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant font-semibold">Exam ID</th>
                        <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant font-semibold">Exam Name</th>
                        <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant font-semibold">Duration</th>
                        <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant font-semibold">Attempts</th>
                        <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant font-semibold">Status</th>
                        <th class="px-md py-sm font-label-sm text-label-sm text-on-surface-variant font-semibold text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/50">
                    @if (Model.Exams.Any())
                    {
                        foreach (var exam in Model.Exams)
                        {
                            <tr class="hover:bg-surface-container-low transition-colors group">
                                <td class="px-md py-sm font-body-sm text-body-sm text-on-surface-variant">#@exam.Id</td>
                                <td class="px-md py-sm font-body-sm text-body-sm text-on-surface font-medium">
                                    <a href="/Exams/Detail?id=@exam.Id" class="text-primary hover:underline font-semibold">
                                        @exam.Title
                                    </a>
                                    @if (!string.IsNullOrEmpty(exam.Description))
                                    {
                                        <p class="text-xs text-on-surface-variant font-normal line-clamp-1 mt-0.5">@exam.Description</p>
                                    }
                                </td>
                                <td class="px-md py-sm font-body-sm text-body-sm text-on-surface-variant">@exam.Duration mins</td>
                                <td class="px-md py-sm font-body-sm text-body-sm text-on-surface-variant">@exam.AttemptCount attempts</td>
                                <td class="px-md py-sm">
                                    @if (exam.IsDeleted)
                                    {
                                        <span class="bg-error-container text-on-error-container px-2.5 py-1 rounded-full font-label-sm text-label-sm flex items-center gap-xs w-fit">
                                            <span class="material-symbols-outlined text-sm">visibility_off</span>
                                            Hidden
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bg-tertiary-fixed text-on-tertiary-fixed-variant px-2.5 py-1 rounded-full font-label-sm text-label-sm flex items-center gap-xs w-fit">
                                            <span class="material-symbols-outlined text-sm">visibility</span>
                                            Public
                                        </span>
                                    }
                                </td>
                                <td class="px-md py-sm text-right">
                                    <div class="flex items-center justify-end gap-sm">
                                        <a href="/Exams/Detail?id=@exam.Id" class="text-on-surface-variant hover:text-primary p-1 rounded hover:bg-surface-container" title="View Details">
                                            <span class="material-symbols-outlined text-sm block">info</span>
                                        </a>
                                        @if (!exam.IsDeleted)
                                        {
                                            <button onclick="confirmSoftDelete(@exam.Id, '@exam.Title')" class="text-on-surface-variant hover:text-error p-1 rounded hover:bg-surface-container" title="Hide/Soft Delete">
                                                <span class="material-symbols-outlined text-sm block">delete</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button onclick="confirmRestore(@exam.Id, '@exam.Title')" class="text-on-surface-variant hover:text-tertiary-container p-1 rounded hover:bg-surface-container" title="Restore/Publish">
                                                <span class="material-symbols-outlined text-sm block">publish</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-12 text-on-surface-variant">
                                <span class="material-symbols-outlined text-display-lg text-outline-variant block mb-sm">inbox</span>
                                <p class="font-headline-sm text-headline-sm mb-xs">No exams found</p>
                                <p class="font-body-sm text-body-sm">Please click the button above to create a new exam.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
<script>

    function confirmSoftDelete(id, title) {
        showConfirm({
            title: 'Hide Exam',
            message: `Are you sure you want to hide the exam "${title}"? Students will no longer be able to take it, but their past attempt history will remain intact.`,
            confirmText: 'Hide Exam',
            isDestructive: true,
            onConfirm: async () => {
                try {
                    const response = await fetch(`/api/Exams/${id}`, {
                        method: 'DELETE'
                    });
                    
                    if (response.ok) {
                        showToast('Exam hidden successfully!', 'success');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        const errorData = await response.json();
                        showToast(errorData.error || 'Failed to hide the exam.', 'error');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('Could not connect to the server.', 'error');
                }
            }
        });
    }

    function confirmRestore(id, title) {
        showConfirm({
            title: 'Restore Exam',
            message: `Are you sure you want to restore and republish the exam "${title}"?`,
            confirmText: 'Restore Exam',
            isDestructive: false,
            onConfirm: async () => {
                try {
                    const response = await fetch(`/api/Exams/${id}/restore`, {
                        method: 'POST'
                    });
                    
                    if (response.ok) {
                        showToast('Exam restored and published successfully!', 'success');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        const errorData = await response.json();
                        showToast(errorData.error || 'Failed to restore the exam.', 'error');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('Could not connect to the server.', 'error');
                }
            }
        });
    }
</script>
}
