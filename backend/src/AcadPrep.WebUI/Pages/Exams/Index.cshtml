@page
@model AcadPrep.WebUI.Pages.Exams.IndexModel
@{
    ViewData["Title"] = "TOEIC Exam Library";
}

<style>
    .soft-shadow {
        box-shadow: 0 4px 20px -2px rgba(30, 0, 169, 0.06);
    }
    .active-pill {
        background-color: #1e00a9;
        color: white;
    }
    .transition-interaction {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .transition-interaction:active {
        transform: scale(0.98);
    }
    .exam-card {
        transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                    box-shadow 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                    border-color 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .exam-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 22px 45px -24px rgba(30, 0, 169, 0.35);
    }
    .exam-card-action {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transform: translateY(10px);
        transition: max-height 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 0.2s ease,
                    transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
                    padding-top 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .exam-card:hover .exam-card-action {
        max-height: 80px;
        opacity: 1;
        transform: translateY(0);
        padding-top: 1rem;
    }
</style>

<main class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop py-xl">
    <!-- Header Section -->
    <section class="mb-3xl">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-xl">
            <div>
                <nav class="flex items-center gap-xs text-on-surface-variant mb-sm">
                    <a href="/" class="flex items-center gap-xs hover:text-primary transition-colors text-label-sm font-label-sm uppercase tracking-wider">
                        <span class="material-symbols-outlined text-[18px]">arrow_back</span> Trang chủ
                    </a>
                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    <span class="text-label-sm font-label-sm uppercase tracking-wider">Exam Library</span>
                    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                    <span class="text-label-sm font-label-sm text-primary uppercase tracking-wider">TOEIC®</span>
                </nav>
                <h1 class="text-headline-lg font-headline-lg text-on-surface mb-xs">TOEIC Exam Library</h1>
                <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl">Browse official TOEIC practice exams and mock tests designed to simulate the real exam environment.</p>
            </div>
            <!-- Quick Stats Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-md">
                <div class="bg-surface-container-low p-md rounded-xl border border-outline-variant/30 min-w-[140px]">
                    <span class="text-label-sm font-label-sm text-on-surface-variant block mb-1">Total Exams</span>
                    <div class="flex items-center gap-xs">
                        <span class="material-symbols-outlined text-primary text-[20px]">description</span>
                        <span class="text-headline-sm font-headline-sm">@(Model.ExamsPaginated?.TotalCount ?? 0)</span>
                    </div>
                </div>
                <div class="bg-surface-container-low p-md rounded-xl border border-outline-variant/30 min-w-[140px]">
                    <span class="text-label-sm font-label-sm text-on-surface-variant block mb-1">Total Attempts</span>
                    <div class="flex items-center gap-xs">
                        <span class="material-symbols-outlined text-primary text-[20px]">groups</span>
                        <span class="text-headline-sm font-headline-sm">@(Model.Exams.Any() ? Model.Exams.Sum(e => e.AttemptCount).ToString("N0") : "0")</span>
                    </div>
                </div>
                <div class="bg-surface-container-low p-md rounded-xl border border-outline-variant/30 min-w-[140px]">
                    <span class="text-label-sm font-label-sm text-on-surface-variant block mb-1">Series</span>
                    <div class="flex items-center gap-xs">
                        <span class="material-symbols-outlined text-primary text-[20px]">collections_bookmark</span>
                        <span class="text-headline-sm font-headline-sm">@(Model.SeriesFilters.Count(s => s != "All"))</span>
                    </div>
                </div>
                <div class="bg-surface-container-low p-md rounded-xl border border-outline-variant/30 min-w-[140px]">
                    <span class="text-label-sm font-label-sm text-on-surface-variant block mb-1">Years</span>
                    <div class="flex items-center gap-xs">
                        <span class="material-symbols-outlined text-primary text-[20px]">date_range</span>
                        <span class="text-headline-sm font-headline-sm">@(Model.YearFilters.Count(y => y != "All"))</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-error-container text-on-error-container p-lg rounded-xl mb-xl flex items-center gap-md">
            <span class="material-symbols-outlined text-[24px]">error</span>
            <span class="text-body-md font-label-md">@Model.ErrorMessage</span>
        </div>
    }

    <!-- Search & Filter Controls -->
    <section class="bg-surface-container-lowest p-lg rounded-2xl border border-outline-variant mb-xl soft-shadow">
        <form method="get" id="filterForm">
            <input type="hidden" asp-for="SelectedSeries" id="selectedSeries" />
            <input type="hidden" asp-for="SelectedYear" id="selectedYear" />
            <input type="hidden" asp-for="CurrentPage" id="currentPage" />

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-lg">
                <!-- Search Bar -->
                <div class="lg:col-span-12 relative">
                    <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                    <input asp-for="Search" class="w-full pl-3xl pr-md py-md bg-surface border border-outline-variant rounded-xl focus:ring-2 focus:ring-primary-container focus:border-primary outline-none transition-all text-body-md" placeholder="Search exams by title, series, or year..." type="text">
                </div>
                <!-- Dropdown Filter: Series -->
                <div class="lg:col-span-4">
                    <label class="block text-label-sm font-label-sm text-on-surface-variant mb-xs">Exam Series</label>
                    <select class="w-full bg-surface border border-outline-variant rounded-lg px-md py-sm text-body-sm focus:ring-primary outline-none" onchange="setFilter('Series', this.value)">
                        @foreach (var series in Model.SeriesFilters)
                        {
                            <option value="@series" selected="@(Model.SelectedSeries == series)">@series</option>
                        }
                    </select>
                </div>
                <!-- Dropdown Filter: Year -->
                <div class="lg:col-span-4">
                    <label class="block text-label-sm font-label-sm text-on-surface-variant mb-xs">Year</label>
                    <select class="w-full bg-surface border border-outline-variant rounded-lg px-md py-sm text-body-sm focus:ring-primary outline-none" onchange="setFilter('Year', this.value)">
                        @foreach (var year in Model.YearFilters)
                        {
                            <option value="@year" selected="@(Model.SelectedYear == year)">@year</option>
                        }
                    </select>
                </div>
                <!-- Search Button -->
                <div class="lg:col-span-4 flex items-end">
                    <button type="submit" class="w-full py-sm bg-primary text-on-primary rounded-lg font-label-md text-label-md hover:bg-primary-container transition-colors flex items-center justify-center gap-sm">
                        <span class="material-symbols-outlined text-[18px]">search</span>
                        Search
                    </button>
                </div>
            </div>
        </form>
        <!-- Quick Filter Chips -->
        <div class="flex flex-wrap items-center gap-sm mt-lg pt-lg border-t border-outline-variant/50">
            <span class="text-label-sm font-label-sm text-on-surface-variant mr-sm">Series:</span>
            @foreach (var series in Model.SeriesFilters)
            {
                var isActive = Model.SelectedSeries == series;
                <button type="button" onclick="setFilter('Series', '@series')"
                    class="px-md py-xs rounded-full border text-label-md font-label-md transition-colors @(isActive ? "bg-primary text-on-primary border-primary" : "border-outline-variant hover:bg-surface-container-high")">
                    @series
                </button>
            }
            <button type="button" onclick="resetFilters()" class="flex items-center gap-xs px-md py-xs rounded-full text-primary hover:bg-primary-fixed transition-colors text-label-md font-label-md ml-auto">
                <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                Reset Filters
            </button>
        </div>
    </section>

    <!-- Exam Grid -->
    @if (Model.Exams.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-lg">
            @foreach (var exam in Model.Exams)
            {
                <!-- Exam Card -->
                <div class="exam-card bg-surface-container-lowest rounded-xl border border-outline-variant flex flex-col hover:border-primary soft-shadow group overflow-hidden relative">
                    <!-- Accent Top Bar -->
                    <div class="h-1 w-full bg-gradient-to-r from-primary to-secondary-container"></div>
                    
                    <div class="p-lg flex flex-col flex-1 relative z-10">
                        <!-- Badges & Series -->
                        <div class="flex items-start justify-between mb-md">
                            <div class="flex flex-wrap gap-xs">
                                <span class="px-sm py-xs bg-surface-container-high text-on-surface-variant text-[11px] font-bold rounded-md border border-outline-variant/30">@exam.SeriesName</span>
                            </div>
                            <div class="flex flex-wrap gap-xs items-center justify-end">
                                @if (exam.Year >= DateTime.Now.Year)
                                {
                                    <span class="px-sm py-[2px] bg-primary-container text-on-primary-container text-[10px] font-bold rounded-full uppercase tracking-tighter">New</span>
                                }
                                @if (exam.AttemptCount > 10000)
                                {
                                    <span class="px-sm py-[2px] bg-secondary-container text-on-secondary-container text-[10px] font-bold rounded-full uppercase tracking-tighter flex items-center gap-[2px]"><span class="material-symbols-outlined text-[12px]">local_fire_department</span>Hot</span>
                                }
                            </div>
                        </div>
                        
                        <!-- Title -->
                        <h3 class="text-headline-sm font-headline-sm text-on-surface group-hover:text-primary transition-colors mb-xs line-clamp-2" title="@exam.Title">@exam.Title</h3>
                        
                        <!-- Description -->
                        <p class="text-body-sm text-on-surface-variant line-clamp-2 mb-lg flex-1">@(string.IsNullOrWhiteSpace(exam.Description) ? "Comprehensive mock exam to test your skills." : exam.Description)</p>
                        
                        <!-- Stats Grid -->
                        <div class="mt-auto bg-surface p-md rounded-xl border border-outline-variant/20 grid grid-cols-2 gap-y-md gap-x-md">
                            <div class="flex flex-col gap-[2px]">
                                <span class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider">Year</span>
                                <div class="flex items-center gap-xs text-on-surface">
                                    <span class="material-symbols-outlined text-[16px] text-primary">calendar_today</span>
                                    <span class="text-label-md font-label-md">@exam.Year</span>
                                </div>
                            </div>
                            <div class="flex flex-col gap-[2px]">
                                <span class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider">Duration</span>
                                <div class="flex items-center gap-xs text-on-surface">
                                    <span class="material-symbols-outlined text-[16px] text-primary">schedule</span>
                                    <span class="text-label-md font-label-md">@exam.Duration m</span>
                                </div>
                            </div>
                            <div class="flex flex-col gap-[2px]">
                                <span class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider">Questions</span>
                                <div class="flex items-center gap-xs text-on-surface">
                                    <span class="material-symbols-outlined text-[16px] text-primary">quiz</span>
                                    <span class="text-label-md font-label-md">@exam.QuestionCount</span>
                                </div>
                            </div>
                            <div class="flex flex-col gap-[2px]">
                                <span class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider">Attempts</span>
                                <div class="flex items-center gap-xs text-on-surface">
                                    <span class="material-symbols-outlined text-[16px] text-primary">analytics</span>
                                    <span class="text-label-md font-label-md">@exam.AttemptCount.ToString("N0")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Primary Action -->
                        <div class="exam-card-action mt-auto">
                            <a asp-page="/Exams/Detail" asp-route-id="@exam.Id" class="w-full py-[10px] bg-primary text-on-primary rounded-lg font-label-md text-label-md text-center flex items-center justify-center gap-xs hover:bg-primary-container hover:text-on-primary-container shadow-md transition-colors">
                                View Details
                                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                    
                    <!-- Decorative background element -->
                    <div class="absolute -bottom-12 -right-12 w-40 h-40 bg-primary/5 rounded-full blur-2xl group-hover:bg-primary/10 transition-colors duration-500 z-0 pointer-events-none"></div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="flex flex-col items-center justify-center py-3xl text-center">
            <span class="material-symbols-outlined text-[64px] text-outline-variant mb-lg">search_off</span>
            <h3 class="text-headline-sm font-headline-sm text-on-surface mb-sm">No exams found</h3>
            <p class="text-body-md text-on-surface-variant max-w-md mb-lg">We couldn't find any exams matching your filters. Try adjusting your search criteria or reset all filters.</p>
            <button type="button" onclick="resetFilters()" class="px-xl py-sm bg-primary text-on-primary rounded-lg font-label-md text-label-md hover:bg-primary-container transition-colors flex items-center gap-sm">
                <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                Reset Filters
            </button>
        </div>
    }

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="mt-3xl flex flex-col items-center gap-md">
            <div class="flex items-center gap-sm">
                <!-- Previous Button -->
                <button onclick="goToPage(@(Model.CurrentPage - 1))"
                    class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant hover:bg-surface-container-low transition-colors disabled:opacity-50"
                    @(Model.HasPreviousPage ? "" : "disabled")>
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>

                @{
                    // Smart pagination: show first, last, and pages around current
                    var totalPages = Model.TotalPages;
                    var current = Model.CurrentPage;
                    var pagesToShow = new List<int>();

                    // Always show first page
                    pagesToShow.Add(1);

                    // Show pages around current
                    for (int i = Math.Max(2, current - 1); i <= Math.Min(totalPages - 1, current + 1); i++)
                    {
                        pagesToShow.Add(i);
                    }

                    // Always show last page if more than 1
                    if (totalPages > 1)
                    {
                        pagesToShow.Add(totalPages);
                    }

                    pagesToShow = pagesToShow.Distinct().OrderBy(x => x).ToList();

                    int? prevPage = null;
                    foreach (var pageNum in pagesToShow)
                    {
                        if (prevPage.HasValue && pageNum - prevPage.Value > 1)
                        {
                            <span class="px-sm text-on-surface-variant">...</span>
                        }

                        if (pageNum == current)
                        {
                            <button class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary text-on-primary font-bold">@pageNum</button>
                        }
                        else
                        {
                            <button onclick="goToPage(@pageNum)" class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant hover:bg-surface-container-low transition-colors">@pageNum</button>
                        }
                        prevPage = pageNum;
                    }
                }

                <!-- Next Button -->
                <button onclick="goToPage(@(Model.CurrentPage + 1))"
                    class="w-10 h-10 flex items-center justify-center rounded-lg border border-outline-variant hover:bg-surface-container-low transition-colors disabled:opacity-50"
                    @(Model.HasNextPage ? "" : "disabled")>
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
            @{
                var startItem = (Model.CurrentPage - 1) * Model.PageSize + 1;
                var endItem = Math.Min(Model.CurrentPage * Model.PageSize, Model.ExamsPaginated?.TotalCount ?? 0);
                var totalCount = Model.ExamsPaginated?.TotalCount ?? 0;
            }
            <p class="text-body-sm font-body-sm text-on-surface-variant">Showing @startItem-@endItem of @totalCount Exams</p>
        </div>
    }
</main>

@section Scripts {
    <script>
        function setFilter(type, value) {
            // Reset page to 1 when changing filters
            document.getElementById('currentPage').value = 1;
            document.getElementById('selected' + type).value = value;
            document.getElementById('filterForm').submit();
        }

        function goToPage(page) {
            document.getElementById('currentPage').value = page;
            document.getElementById('filterForm').submit();
        }

        function resetFilters() {
            document.getElementById('selectedSeries').value = 'All';
            document.getElementById('selectedYear').value = 'All';
            document.getElementById('currentPage').value = 1;
            // Clear search input
            var searchInput = document.querySelector('input[name="Search"]');
            if (searchInput) searchInput.value = '';
            document.getElementById('filterForm').submit();
        }
    </script>
}
