@page
@model AcadPrep.WebUI.Pages.Exams.ReviewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Review answers";
    ViewData["FullWidthContent"] = true;
    var review = Model.Review;
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var questionsJson = JsonSerializer.Serialize(review.Questions, jsonOptions);
    var resultsUrl = review.IsPractice
        ? $"/Exams/Results?sessionId={review.AttemptOrSessionId}"
        : $"/Exams/Results?attemptId={review.AttemptOrSessionId}";
    var initialFilter = string.IsNullOrWhiteSpace(Model.Filter) ? "all" : Model.Filter.ToLowerInvariant();
}

<style>
    .q-cell { min-width: 32px; width: 32px; height: 32px; font-size: 11px; }
    .q-cell-correct { background: #16a34a; color: #fff; border-color: #15803d; }
    .q-cell-incorrect { background: #dc2626; color: #fff; border-color: #b91c1c; }
    .q-cell-unanswered { background: #9e9e9e; color: #fff; border-color: transparent; }
    .q-cell-active { box-shadow: 0 0 0 3px rgba(30, 0, 169, 0.35); transform: scale(1.08); }
    .opt-correct { border-color: #16a34a !important; background: rgba(22, 163, 74, 0.12); }
    .opt-wrong { border-color: #dc2626 !important; background: rgba(220, 38, 38, 0.12); }
    .exam-sidebar.is-open { transform: translateX(0) !important; }
    .review-page {
        min-height: calc(100vh - 64px);
        display: flex;
        flex-direction: column;
    }
    .review-shell {
        flex: 1;
        min-height: 0;
    }
</style>

<div class="review-page bg-surface">
    <div class="shrink-0 border-b border-outline-variant/40 bg-surface-container-lowest px-4 md:px-6 py-3">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="min-w-0 flex items-center gap-3 flex-wrap">
                <a href="@resultsUrl" class="inline-flex items-center gap-1 text-primary text-label-md font-medium hover:underline shrink-0">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span> Results
                </a>
                <span class="hidden sm:inline text-on-surface-variant">/</span>
                <h1 class="font-headline-sm text-on-surface font-bold truncate">@review.ExamTitle</h1>
                <span class="text-body-sm text-on-surface-variant hidden md:inline">
                    @review.TotalScore / @review.MaxScore ·
                    <span class="text-tertiary font-semibold">@review.CorrectCount</span> /
                    <span class="text-error font-semibold">@review.IncorrectCount</span>
                </span>
            </div>
            <div class="flex flex-wrap gap-2 items-center">
                <div class="flex flex-wrap gap-1.5 mr-1">
                    <button type="button" data-filter="all" class="review-filter px-3 py-1.5 rounded-lg bg-primary text-on-primary text-label-md font-bold">All</button>
                    <button type="button" data-filter="incorrect" class="review-filter px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface text-label-md font-bold hover:bg-surface-container">Incorrect</button>
                    <button type="button" data-filter="correct" class="review-filter px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface text-label-md font-bold hover:bg-surface-container">Correct</button>
                    <button type="button" data-filter="unanswered" class="review-filter px-3 py-1.5 rounded-lg bg-surface-container-high text-on-surface text-label-md font-bold hover:bg-surface-container">Unanswered</button>
                </div>
                <button id="btn-sidebar-toggle" type="button" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-outline-variant bg-white hover:bg-surface-container font-label-md text-label-md">
                    <span class="material-symbols-outlined text-[18px]">menu</span>
                    Questions
                </button>
                <a href="/Exams/Detail/@review.ExamId" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-primary-container">
                    Back to exam
                </a>
            </div>
        </div>
    </div>

    <div class="review-shell relative bg-white overflow-hidden">
        <aside id="question-sidebar" class="exam-sidebar absolute inset-y-0 left-0 z-30 w-[300px] max-w-[90vw] bg-white border-r border-outline-variant/40 shadow-2xl flex flex-col -translate-x-full transition-transform duration-200">
            <div class="shrink-0 px-4 py-3 border-b border-outline-variant/30 flex items-center justify-between">
                <div>
                    <h2 class="font-headline-sm font-semibold">Questions</h2>
                    <p class="text-body-sm text-on-surface-variant">
                        <span id="visible-count">@review.Questions.Count</span> shown
                    </p>
                </div>
                <button id="btn-sidebar-close" type="button" class="w-8 h-8 rounded-lg hover:bg-surface-container flex items-center justify-center">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div id="question-palette" class="flex-1 overflow-y-auto p-3 space-y-4"></div>
        </aside>
        <div id="sidebar-backdrop" class="exam-sidebar-backdrop absolute inset-0 z-20 bg-black/30 hidden"></div>

        <div id="exam-workspace" class="relative h-full min-h-[calc(100vh-130px)] flex flex-col p-4 md:p-6 gap-4">
            <div class="flex items-center justify-between shrink-0 gap-3 flex-wrap">
                <div class="flex items-center gap-2 flex-wrap">
                    <span id="question-label" class="text-label-sm font-bold text-primary">Question —</span>
                    <span id="status-badge" class="px-2.5 py-1 rounded-md text-label-sm font-bold"></span>
                </div>
                <span class="px-3 py-1 rounded-md bg-primary text-on-primary text-label-sm font-bold tabular-nums">
                    <span id="current-q-num">1</span> / <span id="total-q-num">@review.Questions.Count</span>
                </span>
            </div>

            <section id="audio-section" class="shrink-0 bg-surface-container-low rounded-xl border border-outline-variant/30 p-3 hidden">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-body-sm font-medium text-on-surface-variant">Audio</span>
                </div>
                <audio id="review-audio" class="w-full" controls preload="none" controlsList="nodownload"></audio>
            </section>

            <section class="flex-1 min-h-0 grid grid-cols-1 lg:grid-cols-2 gap-0 rounded-xl border border-outline-variant/30 overflow-hidden bg-white">
                <div class="p-5 md:p-8 min-h-[220px] overflow-y-auto border-b lg:border-b-0 lg:border-r-4 lg:border-r-primary/40 space-y-4">
                    <div id="passage-wrap" class="hidden bg-surface-container-low rounded-xl p-4 border border-outline-variant/30 space-y-3">
                        <img id="passage-image" alt="Passage" class="hidden max-h-64 rounded-lg mx-auto border border-outline-variant/30" />
                        <div id="passage-content" class="text-body-sm text-on-surface whitespace-pre-wrap"></div>
                    </div>
                    <div id="question-image-wrap" class="hidden">
                        <img id="question-image" alt="Question" class="max-h-80 rounded-lg mx-auto border border-outline-variant/30" />
                    </div>
                    <div id="question-text" class="text-body-md text-on-surface whitespace-pre-wrap font-medium"></div>
                </div>
                <div class="p-5 md:p-8 space-y-3 overflow-y-auto flex flex-col">
                    <div id="options-container" class="space-y-3"></div>
                    <div id="explanation-panel" class="mt-auto pt-4 hidden">
                        <div class="bg-primary/5 border border-primary/20 rounded-xl p-4">
                            <p class="text-label-sm font-bold text-primary mb-2 flex items-center gap-1">
                                <span class="material-symbols-outlined text-[18px]">lightbulb</span>
                                Explanation
                            </p>
                            <p id="explanation-text" class="font-body-sm text-on-surface whitespace-pre-wrap"></p>
                        </div>
                    </div>
                    <div id="explanation-empty" class="mt-auto pt-4 hidden">
                        <p class="text-body-sm text-on-surface-variant italic">No explanation available for this question.</p>
                    </div>
                </div>
            </section>

            <div class="flex items-center justify-between shrink-0 py-1">
                <button id="btn-prev" type="button" class="flex items-center gap-1 px-4 py-2.5 rounded-xl border border-outline-variant/40 hover:bg-surface-container font-medium disabled:opacity-40">
                    <span class="material-symbols-outlined">arrow_back</span> Prev
                </button>
                <span class="text-body-sm font-medium text-on-surface-variant">
                    Part <span id="current-part-label">—</span>
                </span>
                <button id="btn-next" type="button" class="flex items-center gap-1 px-4 py-2.5 rounded-xl bg-primary text-on-primary font-medium hover:bg-primary-container disabled:opacity-40">
                    Next <span class="material-symbols-outlined">arrow_forward</span>
                </button>
            </div>
        </div>

        <div id="empty-filter" class="hidden absolute inset-0 flex items-center justify-center p-6 bg-white">
            <div class="text-center max-w-sm space-y-3">
                <span class="material-symbols-outlined text-5xl text-on-surface-variant">filter_list_off</span>
                <h3 class="font-headline-sm font-bold">No questions in this filter</h3>
                <p class="text-body-sm text-on-surface-variant">Try another filter above.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.examReviewConfig = {
            examId: @review.ExamId,
            resultsUrl: @Html.Raw(JsonSerializer.Serialize(resultsUrl)),
            initialFilter: @Html.Raw(JsonSerializer.Serialize(initialFilter)),
            questions: @Html.Raw(questionsJson)
        };
    </script>
    <script src="~/js/exam-review.js"></script>
}
