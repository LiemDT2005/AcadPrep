@page
@model AcadPrep.WebUI.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Course List";
}

<div class="card shadow-2-strong">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Course List</h5>
        <a href="#" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i> Add Course
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th scope="col" class="fw-bold text-muted">TITLE</th>
                        <th scope="col" class="fw-bold text-muted">DESCRIPTION</th>
                        <th scope="col" class="fw-bold text-muted">LEVEL</th>
                        <th scope="col" class="fw-bold text-muted">PRICE</th>
                        <th scope="col" class="fw-bold text-muted text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Courses.Any())
                    {
                        foreach (var course in Model.Courses)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@course.Title</div>
                                </td>
                                <td>
                                    <span class="text-muted text-truncate d-inline-block" style="max-width: 250px;">
                                        @course.Description
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill badge-success">@course.Level</span>
                                </td>
                                <td>
                                    <div class="fw-bold">@course.Price.ToString("N0") VNĐ</div>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-link text-primary btn-sm px-2"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-link text-danger btn-sm px-2"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-inbox fa-3x mb-3 text-light"></i>
                                <h6>No courses found</h6>
                                <p class="small mb-0">There are currently no courses available.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
