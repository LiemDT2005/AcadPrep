@startuml


hide footbox

actor Guest
participant ":Detail.cshtml" as View
participant ":DetailModel" as PageModel
participant ":ValidationBehavior" as Pipeline
participant ":GetExamDetailQueryHandler" as Handler
participant ":ICacheService" as CacheService
database "Redis" as Redis
participant ":IAppDbContext" as DbContext
database "SQL Server" as DB

Guest -> View : 1 Click exam card → GET /Exams/{id}
activate Guest
activate View

View -> PageModel : 2 Request page data examId
activate PageModel

PageModel -> Pipeline : 3 Send GetExamDetailQueryexamId
activate Pipeline

Pipeline -> Pipeline : 4 Validate examId not empty
Pipeline -> Handler : 5 Forward to handler
activate Handler

Handler -> CacheService : 6 Check cache (key: ExamDetail:{id})
activate CacheService

CacheService -> Redis : 7 Get exam detail
activate Redis
Redis --> CacheService : 8 Return data or null
deactivate Redis

CacheService --> Handler : 9 Return cache result
deactivate CacheService

alt Cache HIT
    Handler --> Pipeline : 10.1 Return cached detail
    
    Pipeline --> PageModel : 11.1 Return cached detail
    
    PageModel --> View : 12.1 Pass exam detail to view
    View --> Guest : 13.1 Render exam detail page
else Cache MISS
    Handler -> DbContext : 10.2 Query exam by Id\n(where !IsDeleted && Status == Published)
    activate DbContext

    DbContext -> DB : 11.2 Execute query (BR-15)
    activate DB

    alt Exam found 
        DB --> DbContext : 12.2a Return exam row
        DbContext --> Handler : 13.2a Return exam entity
        deactivate DbContext

        Handler -> CacheService : 14.2a Cache exam detail (TTL 30m, BR-13)
        activate CacheService
        CacheService -> Redis : 15.2a Write to cache
        activate Redis
        Redis --> CacheService : 16.2a Write confirmed
        deactivate Redis
        deactivate CacheService

        Handler --> Pipeline : 17.2a Return exam detail DTO
        
        Pipeline --> PageModel : 18.2a Return exam detail DTO

        PageModel --> View : 19.2a Pass exam detail to view\n
        
        alt Guest not logged in (Normal Flow)
            View --> Guest : 20.2a_1 Render page with\n"Log in to start" button
        else User is logged in A1
            alt Never done the test
                View --> Guest : 20.2a_2 Render page with\n"Start" button → UC-8.1
            else In progress (BR-04)
                View --> Guest : 20.2a_3 Render page with\n"Resume" button → UC-8.5
            else Completed (BR-05)
                View --> Guest : 20.2a_4 Render page with\n"Retake" / "View Result" button → UC-9.1
            end
        end
    else Exam not found or soft-deleted 
        DB --> DbContext : 12.2b Return empty / null
        deactivate DB
        activate DbContext
        DbContext --> Handler : 13.2b Return null
        deactivate DbContext
        
        Handler --> Pipeline : 14.2b Throw NotFoundException 404
        deactivate Handler
        
        Pipeline --> PageModel : 15.2b Propagate exception
        deactivate Pipeline
        
        PageModel --> View : 16.2b Redirect to /Exams with error
        deactivate PageModel
        View --> Guest : 17.2b Show exam list + error message
        deactivate View
        deactivate Guest
    end
end

deactivate View
deactivate Guest
@enduml
