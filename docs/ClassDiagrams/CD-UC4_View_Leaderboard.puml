@startuml CD-UC4_View_Leaderboard

title Class Diagram – UC4: View Leaderboard

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classAttributeIconSize 0
top to bottom direction

skinparam class {
  BorderColor Black
  BackgroundColor White
}

' ══════════════════════════════════════════════
' PRESENTATION LAYER  [AcadPrep.WebUI]
' ══════════════════════════════════════════════

class "LeaderboardModel" as LeaderboardModel <<PageModel>> {
  - _mediator : ISender
  + LeaderboardEntries : List<LeaderboardEntryDto>
  __
  + OnGetAsync() : Task
}

' ══════════════════════════════════════════════
' APPLICATION LAYER  [AcadPrep.Application]
' ══════════════════════════════════════════════

class "GetLeaderboardQuery" as Query <<Record>> {
  __
}

class "GetLeaderboardQueryHandler" as Handler {
  - _context : IAppDbContext
  - _cache : ICacheService
  __
  + Handle(request : GetLeaderboardQuery, cancellationToken : CancellationToken) : Task<Result<List<LeaderboardEntryDto>>>
}

class "LeaderboardEntryDto" as DTO <<DTO>> {
  + Rank : int
  + UserId : int
  + FullName : string
  + TotalScore : int
  + ListeningScore : int
  + ReadingScore : int
  + AttemptCount : int
  __
}

class "ValidationBehavior<TRequest, TResponse>" as VB <<Behavior>> {
  - _validators : IEnumerable<IValidator<TRequest>>
  __
  + Handle(request : TRequest, next : RequestHandlerDelegate<TResponse>, cancellationToken : CancellationToken) : Task<TResponse>
}

interface "ICacheService" as ICache <<interface>> {
  + GetAsync<T>(key : string, cancellationToken : CancellationToken) : Task<T?>
  + SetAsync<T>(key : string, value : T, slidingExpiration : TimeSpan?, cancellationToken : CancellationToken) : Task
  + RemoveAsync(key : string, cancellationToken : CancellationToken) : Task
}

interface "IAppDbContext" as IDb <<interface>> {
  + ExamAttempts : DbSet<ExamAttempt>
  + Users : DbSet<User>
  __
  + SaveChangesAsync(cancellationToken : CancellationToken) : Task<int>
}

' ══════════════════════════════════════════════
' DOMAIN LAYER  [AcadPrep.Domain]
' ══════════════════════════════════════════════

abstract class "BaseEntity<TId>" as BaseEntity <<Abstract>> {
  # Id : TId
  # CreatedAt : DateTime
  # LastModifiedAt : DateTime?
  __
}

interface "IAuditable" as IAuditable <<interface>> {
  + CreatedAt : DateTime
  + LastModifiedAt : DateTime?
  __
}

class "User" as UserEntity <<Entity>> {
  - Email : string
  - PasswordHash : string
  - FullName : string
  - Status : UserStatus
  - RoleId : int
  - CreatedAt : DateTime
  - LastModifiedAt : DateTime?
  __
}

class "ExamAttempt" as AttemptEntity <<Entity>> {
  - Id : int
  - ExamId : int
  - UserId : int
  - TotalScore : int
  - ListeningScore : int
  - ReadingScore : int
  - StartedAt : DateTime
  - CompletedAt : DateTime?
  - IsSubmitted : bool
  - RemainingTime : int
  __
}

' ══════════════════════════════════════════════
' INFRASTRUCTURE LAYER  [AcadPrep.Infrastructure]
' ══════════════════════════════════════════════

class "RedisCacheService" as RedisCache {
  - _cache : IDistributedCache
  __
  + GetAsync<T>(key : string, cancellationToken : CancellationToken) : Task<T?>
  + SetAsync<T>(key : string, value : T, slidingExpiration : TimeSpan?, cancellationToken : CancellationToken) : Task
  + RemoveAsync(key : string, cancellationToken : CancellationToken) : Task
}

class "AppDbContext" as DbCtx {
  + ExamAttempts : DbSet<ExamAttempt>
  + Users : DbSet<User>
  __
  # OnModelCreating(modelBuilder : ModelBuilder) : void
}


' ══════════════════════════════════════════════
' RELATIONSHIPS
' ══════════════════════════════════════════════

' --- Inheritance (Generalization) ---
' Solid line, hollow arrowhead → "is-a"
UserEntity --|> BaseEntity : extends
AttemptEntity --|> BaseEntity : extends

' --- Realization (Interface Implementation) ---
' Dashed line, hollow arrowhead → "implements"
UserEntity ..|> IAuditable
RedisCache ..|> ICache
DbCtx ..|> IDb

' --- Dependency ---
' Dashed line, open arrow → "uses / creates"
LeaderboardModel ..> Query : <<create>>\nsends
LeaderboardModel ..> DTO : <<use>>\ndisplays

VB ..> Query : validates

Handler ..> DTO : <<create>>\nmaps to
Handler ..> AttemptEntity : <<use>>\nreads

' --- Association (Directed) ---
' Solid line → structural link
Handler --> ICache : uses
Handler --> IDb : uses

' --- Association between Domain Entities ---
' with multiplicity
UserEntity "1" -- "0..*" AttemptEntity : has >

' --- Dependency across layers ---
' Pipeline flow: PageModel → ValidationBehavior → Handler
LeaderboardModel ..> VB : sends via pipeline
VB ..> Handler : forwards to

@enduml
