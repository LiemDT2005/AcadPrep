@startuml

skinparam ActivityBackgroundColor white
skinparam ActivityBorderColor black
skinparam ActivityDiamondBackgroundColor white
skinparam ActivityDiamondBorderColor black

|Guest|
start
:1. Selects filter criteria;

:2. Clicks apply filter;

|System|
:3. Validates filter parameters;
:4. Queries published exams matching filters;

if () then ([Found Exam])
  :5. Displays filtered exam cards;

  |Guest|
  :6. Views filtered results;

  if () then ([Click exam card])
    :View Detail;
  elseif () then ([Change filter criteria])
    :Filter exam;
  elseif () then ([Click search button])
    :Search exam;
  else ([Clear all filters])
    :View all exams;
  endif

else ([No Exam Found])
  :7. Displays no matches message;

  |Guest|
  :8. Views empty state;
endif

stop

@enduml
