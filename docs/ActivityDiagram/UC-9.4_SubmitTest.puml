@startuml

skinparam ActivityBackgroundColor white
skinparam ActivityBorderColor black
skinparam ActivityDiamondBackgroundColor white
skinparam ActivityDiamondBorderColor black

|User|
start

if () then ([Clicks Submit])
  :1. Confirms submission;
else ([Timer expires])
  |System|
  :1. Auto-triggers submission;
endif

|System|
:2. Collects all selected answers;
:3. Calculates score;
:4. Saves results to database;
:5. Marks attempt as completed;
:6. Displays result summary;

|User|
:7. Views test results;

stop

@enduml
