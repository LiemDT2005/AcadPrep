@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Inter"
skinparam ObjectFontSize 14
skinparam ArrowFontSize 13
skinparam nodesep 130
skinparam ranksep 200
skinparam wrapWidth 150
left to right direction

object "Actor: Student" as student
object ":Profile.cshtml (History Tab)" as view
object ":ProfileModel" as pageModel
object ":GetStudyHistoryQuery" as query
object ":GetStudyHistoryQueryHandler" as handler
object ":IAppDbContext" as dbContext
object "SQL Server" as db

student -> view : 1: Click "Study History" tab (or GET /Account/Profile?tab=history)
view -> pageModel : 2: Page Request (tab = 'history')
pageModel -> query : 3: Create GetStudyHistoryQuery(userId)
pageModel -> handler : 4: Send query via MediatR

handler -> dbContext : 5: Query ExamAttempts (IsSubmitted)
handler -> dbContext : 6: Query PracticeSessions (IsSubmitted)
handler -> dbContext : 7: Query SavedVocabularies (added words)
handler -> dbContext : 8: Query UserAchievements (unlocked badges)

dbContext -> db : 9: Execute SQL Selects
db --> dbContext : 10: Return entity collections
dbContext --> handler : 11: Return raw activity records

handler -> handler : 12: Aggregate activities chronologically (sort by date descending, map to StudyActivityDto)

handler --> pageModel : 13: Return StudyHistoryDto
pageModel --> view : 14: Pass history DTO to View
view --> student : 15: Render interactive chronological learning timeline
@enduml
