        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ActivityDiamondBackgroundColor white\nskinparam ActivityDiamondBorderColor black\n\n|User|\nstart\n:1. Clicks Start Full Test;\n\n|System|\n:2. Validates exam exists;\n\nif (Exam valid?) then ([Yes])\n  :3. Checks existing incomplete attempt;\n\n  if () then ([Has incomplete attempACt])\n    :4. Redirects to Resume Test;\n\n    |User|\n    :5. Views resume test page;\n\n  else ([No incomplete attempt])\n    :4. Creates ExamAttempt entity;\n    :5. Saves attempt to database;\n    :6. Loads all 7 Parts with countdown timer;\n\n    |User|\n    :7. Views full test page;\n  endif\n\nelse ([No])\n  :3. Displays error message;\n\n  |User|\n  :4. Views error;\nendif\n\nstop\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="xy_wx-5qBT9cQ7zI2EoL-1">
