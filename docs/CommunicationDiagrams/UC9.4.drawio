  <diagram id="hrR-su4-aOCEsmRvu560" name="Page-10">
    <mxGraphModel dx="1770" dy="2157" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml CD-UC4_View_Leaderboard\n\ntitle Class Diagram – UC4: View Leaderboard\n\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 11\nskinparam classAttributeIconSize 0\ntop to bottom direction\n\nskinparam class {\n  BorderColor Black\n  BackgroundColor White\n}\n\n&#39; ══════════════════════════════════════════════\n&#39; PRESENTATION LAYER  [AcadPrep.WebUI]\n&#39; ══════════════════════════════════════════════\n\nclass \&quot;LeaderboardModel\&quot; as LeaderboardModel &lt;&lt;PageModel&gt;&gt; {\n  - _mediator : ISender\n  + LeaderboardEntries : List&lt;LeaderboardEntryDto&gt;\n  __\n  + OnGetAsync() : Task\n}\n\n&#39; ══════════════════════════════════════════════\n&#39; APPLICATION LAYER  [AcadPrep.Application]\n&#39; ══════════════════════════════════════════════\n\nclass \&quot;GetLeaderboardQuery\&quot; as Query &lt;&lt;Record&gt;&gt; {\n  __\n}\n\nclass \&quot;GetLeaderboardQueryHandler\&quot; as Handler {\n  - _context : IAppDbContext\n  - _cache : ICacheService\n  __\n  + Handle(request : GetLeaderboardQuery, cancellationToken : CancellationToken) : Task&lt;Result&lt;List&lt;LeaderboardEntryDto&gt;&gt;&gt;\n}\n\nclass \&quot;LeaderboardEntryDto\&quot; as DTO &lt;&lt;DTO&gt;&gt; {\n  + Rank : int\n  + UserId : int\n  + FullName : string\n  + TotalScore : int\n  + ListeningScore : int\n  + ReadingScore : int\n  + AttemptCount : int\n  __\n}\n\nclass \&quot;ValidationBehavior&lt;TRequest, TResponse&gt;\&quot; as VB &lt;&lt;Behavior&gt;&gt; {\n  - _validators : IEnumerable&lt;IValidator&lt;TRequest&gt;&gt;\n  __\n  + Handle(request : TRequest, next : RequestHandlerDelegate&lt;TResponse&gt;, cancellationToken : CancellationToken) : Task&lt;TResponse&gt;\n}\n\ninterface \&quot;ICacheService\&quot; as ICache &lt;&lt;interface&gt;&gt; {\n  + GetAsync&lt;T&gt;(key : string, cancellationToken : CancellationToken) : Task&lt;T?&gt;\n  + SetAsync&lt;T&gt;(key : string, value : T, slidingExpiration : TimeSpan?, cancellationToken : CancellationToken) : Task\n  + RemoveAsync(key : string, cancellationToken : CancellationToken) : Task\n}\n\ninterface \&quot;IAppDbContext\&quot; as IDb &lt;&lt;interface&gt;&gt; {\n  + ExamAttempts : DbSet&lt;ExamAttempt&gt;\n  + Users : DbSet&lt;User&gt;\n  __\n  + SaveChangesAsync(cancellationToken : CancellationToken) : Task&lt;int&gt;\n}\n\n&#39; ══════════════════════════════════════════════\n&#39; DOMAIN LAYER  [AcadPrep.Domain]\n&#39; ══════════════════════════════════════════════\n\nabstract class \&quot;BaseEntity&lt;TId&gt;\&quot; as BaseEntity &lt;&lt;Abstract&gt;&gt; {\n  # Id : TId\n  # CreatedAt : DateTime\n  # LastModifiedAt : DateTime?\n  __\n}\n\ninterface \&quot;IAuditable\&quot; as IAuditable &lt;&lt;interface&gt;&gt; {\n  + CreatedAt : DateTime\n  + LastModifiedAt : DateTime?\n  __\n}\n\nclass \&quot;User\&quot; as UserEntity &lt;&lt;Entity&gt;&gt; {\n  - Email : string\n  - PasswordHash : string\n  - FullName : string\n  - Status : UserStatus\n  - RoleId : int\n  - CreatedAt : DateTime\n  - LastModifiedAt : DateTime?\n  __\n}\n\nclass \&quot;ExamAttempt\&quot; as AttemptEntity &lt;&lt;Entity&gt;&gt; {\n  - Id : int\n  - ExamId : int\n  - UserId : int\n  - TotalScore : int\n  - ListeningScore : int\n  - ReadingScore : int\n  - StartedAt : DateTime\n  - CompletedAt : DateTime?\n  - IsSubmitted : bool\n  - RemainingTime : int\n  __\n}\n\n&#39; ══════════════════════════════════════════════\n&#39; INFRASTRUCTURE LAYER  [AcadPrep.Infrastructure]\n&#39; ══════════════════════════════════════════════\n\nclass \&quot;RedisCacheService\&quot; as RedisCache {\n  - _cache : IDistributedCache\n  __\n  + GetAsync&lt;T&gt;(key : string, cancellationToken : CancellationToken) : Task&lt;T?&gt;\n  + SetAsync&lt;T&gt;(key : string, value : T, slidingExpiration : TimeSpan?, cancellationToken : CancellationToken) : Task\n  + RemoveAsync(key : string, cancellationToken : CancellationToken) : Task\n}\n\nclass \&quot;AppDbContext\&quot; as DbCtx {\n  + ExamAttempts : DbSet&lt;ExamAttempt&gt;\n  + Users : DbSet&lt;User&gt;\n  __\n  # OnModelCreating(modelBuilder : ModelBuilder) : void\n}\n\n\n&#39; ══════════════════════════════════════════════\n&#39; RELATIONSHIPS\n&#39; ══════════════════════════════════════════════\n\n&#39; --- Inheritance (Generalization) ---\n&#39; Solid line, hollow arrowhead → \&quot;is-a\&quot;\nUserEntity --|&gt; BaseEntity : extends\nAttemptEntity --|&gt; BaseEntity : extends\n\n&#39; --- Realization (Interface Implementation) ---\n&#39; Dashed line, hollow arrowhead → \&quot;implements\&quot;\nUserEntity ..|&gt; IAuditable\nRedisCache ..|&gt; ICache\nDbCtx ..|&gt; IDb\n\n&#39; --- Dependency ---\n&#39; Dashed line, open arrow → \&quot;uses / creates\&quot;\nLeaderboardModel ..&gt; Query : &lt;&lt;create&gt;&gt;\\nsends\nLeaderboardModel ..&gt; DTO : &lt;&lt;use&gt;&gt;\\ndisplays\n\nVB ..&gt; Query : validates\n\nHandler ..&gt; DTO : &lt;&lt;create&gt;&gt;\\nmaps to\nHandler ..&gt; AttemptEntity : &lt;&lt;use&gt;&gt;\\nreads\n\n&#39; --- Association (Directed) ---\n&#39; Solid line → structural link\nHandler --&gt; ICache : uses\nHandler --&gt; IDb : uses\n\n&#39; --- Association between Domain Entities ---\n&#39; with multiplicity\nUserEntity \&quot;1\&quot; -- \&quot;0..*\&quot; AttemptEntity : has &gt;\n\n&#39; --- Dependency across layers ---\n&#39; Pipeline flow: PageModel → ValidationBehavior → Handler\nLeaderboardModel ..&gt; VB : sends via pipeline\nVB ..&gt; Handler : forwards to\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="_yLPPf2YymraGEorDiXl-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="907" width="2272" x="270" y="-10" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
