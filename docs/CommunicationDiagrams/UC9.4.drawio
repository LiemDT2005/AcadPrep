        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ActivityDiamondBackgroundColor white\nskinparam ActivityDiamondBorderColor black\n\n|User|\nstart\n:1. Selects Part (Part 1 - Part 7);\n:2. Clicks Practice;\n\n|System|\n:3. Validates exam and part number;\n\nif (Valid?) then ([Yes])\n  :4. Queries questions for selected Part;\n\n  if () then ([Found Questions])\n    :5. Creates practice ExamAttempt entity;\n    :6. Saves attempt to database;\n    :7. Loads Part questions (no countdown timer);\n\n    |User|\n    :8. Views practice page;\n\n  else ([No Questions Found])\n    :5. Displays error message;\n\n    |User|\n    :6. Views error;\n  endif\n\nelse ([No])\n  :4. Displays validation error;\n\n  |User|\n  :5. Views error;\nendif\n\nstop\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="BKZsVIWd47G3jnrOHUlN-1">
