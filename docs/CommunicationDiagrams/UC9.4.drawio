  <diagram id="mv2k1PJHE3peN9ZECBq7" name="Page-9">
    <mxGraphModel dx="1414" dy="922" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ActivityDiamondBackgroundColor white\nskinparam ActivityDiamondBorderColor black\n\n|User|\nstart\n:1. Clicks Resume Test;\n\n|System|\n:2. Queries incomplete attempt from database;\n\nif (Attempt found?) then ([Yes])\n  :3. Loads saved answers;\n  :4. Restores remaining countdown time;\n  :5. Renders test page with previous state;\n\n  |User|\n  :6. Continues test from where left off;\n\nelse ([No])\n  :3. Displays no incomplete attempt message;\n\n  |User|\n  :4. Views message;\nendif\n\nstop\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="7Vrf3Hzw0VXxXKIXW6EE-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
