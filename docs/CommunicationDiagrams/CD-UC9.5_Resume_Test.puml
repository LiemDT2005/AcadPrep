@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Inter"
skinparam ObjectFontSize 14
skinparam ArrowFontSize 13
skinparam nodesep 130
skinparam ranksep 200
skinparam wrapWidth 150
left to right direction

object "Actor: Student" as student
object ":Detail.cshtml" as detailView
object ":Take.cshtml" as takeView
object "exam-session.js" as script
object ":TakeModel" as pageModel
object ":GetTestSessionQuery" as query
object ":GetTestSessionQueryHandler" as handler
object ":IAppDbContext" as dbContext
object "SQL Server" as db

student -> detailView : 1: Open Exam Detail
detailView -> pageModel : 2: Check active attempt
pageModel -> dbContext : 3: Query active attempts (!IsSubmitted)
dbContext -> db : 4: Fetch
db --> dbContext : 5: Return active attempt
dbContext --> pageModel : 6: Active attempt details
pageModel --> detailView : 7: Render detail page with "Resume Banner"
student -> detailView : 8: Click "Resume Test"
detailView -> takeView : 9: Redirect to GET /Exams/Take?attemptId=...

takeView -> pageModel : 10: Request Take Page with attemptId
pageModel -> query : 11: Create GetTestSessionQuery(attemptId, userId)
pageModel -> handler : 12: Send query via MediatR
handler -> dbContext : 13: Query Attempt, saved answers, questions
dbContext -> db : 14: Fetch entities
db --> dbContext : 15: Return entities
dbContext --> handler : 16: Return data
handler --> pageModel : 17: Return TestSessionDto (RemainingSeconds, SavedAnswers, Index)
pageModel --> takeView : 18: Render page with window.examSessionConfig JSON
takeView -down-> script : 19: Initialize script
script -> script : 20: Sync localStorage progress & restore remaining time
script -> script : 21: Render saved answers and set current question index
script -> script : 22: Start countdown timer

student -> takeView : 23: Click "Exit test"
takeView -> script : 24: Show leave modal (modal-leave)
student -> takeView : 25: Click "Save & exit"
script -> pageModel : 26: POST request '?handler=SaveProgress' (attemptId, remainingSeconds)
pageModel -> dbContext : 27: SaveProgressCommand -> Update remaining seconds
dbContext -> db : 28: SaveChangesAsync
db --> dbContext : 29: Commit
dbContext --> pageModel : 30: Success
pageModel --> script : 31: Return JSON response
script -> takeView : 32: Redirect to Detail Page
@enduml
