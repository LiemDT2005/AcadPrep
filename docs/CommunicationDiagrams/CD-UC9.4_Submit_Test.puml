@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Inter"
skinparam ObjectFontSize 14
skinparam ArrowFontSize 13
skinparam nodesep 130
skinparam ranksep 200
skinparam wrapWidth 150
left to right direction

object "Actor: Student" as student
object ":Take.cshtml" as view
object "exam-session.js" as script
object ":Take.cshtml.cs" as pageModel
object ":SubmitTestCommand" as command
object ":SubmitTestCommandHandler" as handler
object ":IAppDbContext" as dbContext
object "SQL Server" as db

student -> view : 1: Click "Submit" button
view -> script : 2: Show confirm modal (modal-submit)
student -> view : 3: Click "Confirm" in modal
script -> script : 4: Invoke submitTest()
script -> script : 5: Countdown reaches 0
script -> view : 6: Show timeout modal (modal-timeout)
script -> script : 7: Invoke submitTest()

script -> pageModel : 8: POST request '?handler=Submit' (attemptId, remainingSeconds)
pageModel -> command : 9: Create SubmitTestCommand(attemptId, userId, remainingSeconds)
pageModel -> handler : 10: Send command via MediatR
handler -> dbContext : 11: Get ExamAttempt & Exam Questions
dbContext -> db : 12: Query attempt, answers & key options
db --> dbContext : 13: Return entities
dbContext --> handler : 14: Return data
handler -> handler : 15: Calculate Score (grading details & map TOEIC score)
handler -> dbContext : 16: Update ExamAttempt (IsSubmitted=true, Scores, CompletedAt)
dbContext -> db : 17: SaveChangesAsync (Save attempt update)
db --> dbContext : 18: Commit Transaction
dbContext --> handler : 19: Save successful
handler --> pageModel : 20: Return success & score DTO
pageModel --> script : 21: Return JSON success response
script -> script : 22: Clear local progress (clearLocalProgress())
script -> view : 23: Redirect to /Exams/Results?attemptId=...
view --> student : 24: Render test results screen
@enduml
